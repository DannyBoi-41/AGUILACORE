/* =====================================================
   LOAD ECONOMIC NEWS
   ===================================================== */

async function loadEconomicNews() {

    showNewsLoading();

    hideNewsError();


    try {

        const response =
            await fetch(
                ECONOMIC_FUNCTION,
                {
                    method: "GET",

                    headers: {
                        "Content-Type":
                            "application/json"
                    }
                }
            );


        if (!response.ok) {

            throw new Error(
                "HTTP " +
                response.status
            );

        }


        const result =
            await response.json();


        /*
           The Edge Function may return:

           [
              {...},
              {...}
           ]

           or:

           {
              data: [...]
           }

           or:

           {
              events: [...]
           }
        */

        let events = [];


        if (
            Array.isArray(result)
        ) {

            events = result;

        } else if (
            result &&
            Array.isArray(result.data)
        ) {

            events = result.data;

        } else if (
            result &&
            Array.isArray(result.events)
        ) {

            events = result.events;

        }


        economicNewsData =
            normalizeEconomicNews(
                events
            );


        updateEconomicSummary();


        filteredEconomicNews =
            economicNewsData.slice();


        renderEconomicNews(
            filteredEconomicNews
        );


        updateFilterStatus(
            filteredEconomicNews.length
        );


    } catch (error) {

        console.error(
            "Economic calendar error:",
            error
        );


        economicNewsData = [];

        filteredEconomicNews = [];


        showNewsError();

        updateEconomicSummary();


        document.getElementById(
            "filterStatus"
        ).textContent =
            "Economic calendar connection unavailable.";

    }

}


/* =====================================================
   NORMALIZE ECONOMIC DATA
   ===================================================== */

function normalizeEconomicNews(
    events
) {

    return events.map(
        function(event) {

            const date =
                getFirstValue(
                    event,
                    [
                        "date",
                        "event_date",
                        "day",
                        "release_date"
                    ]
                );


            const time =
                getFirstValue(
                    event,
                    [
                        "time",
                        "event_time",
                        "release_time"
                    ]
                );


            const title =
                getFirstValue(
                    event,
                    [
                        "event",
                        "title",
                        "name",
                        "event_name"
                    ]
                );


            const currency =
                getFirstValue(
                    event,
                    [
                        "currency",
                        "country",
                        "code"
                    ]
                );


            let impact =
                getFirstValue(
                    event,
                    [
                        "impact",
                        "importance",
                        "priority"
                    ]
                );


            const actual =
                getFirstValue(
                    event,
                    [
                        "actual"
                    ]
                );


            const forecast =
                getFirstValue(
                    event,
                    [
                        "forecast",
                        "consensus"
                    ]
                );


            const previous =
                getFirstValue(
                    event,
                    [
                        "previous"
                    ]
                );


            impact =
                normalizeImpact(
                    impact
                );


            return {

                date:
                    normalizeDate(
                        date
                    ),

                time:
                    normalizeTime(
                        time
                    ),

                event:
                    cleanValue(
                        title,
                        "Economic Event"
                    ),

                currency:
                    cleanValue(
                        currency,
                        "—"
                    ),

                impact:
                    impact,

                actual:
                    cleanValue(
                        actual,
                        "—"
                    ),

                forecast:
                    cleanValue(
                        forecast,
                        "—"
                    ),

                previous:
                    cleanValue(
                        previous,
                        "—"
                    )

            };

        }
    )
    .filter(
        function(event) {

            return event.date ||
                   event.event;

        }
    )
    .sort(
        function(a, b) {

            const first =
                (
                    a.date +
                    " " +
                    a.time
                );

            const second =
                (
                    b.date +
                    " " +
                    b.time
                );

            return first.localeCompare(
                second
            );

        }
    );

}


/* =====================================================
   GET FIRST VALUE
   ===================================================== */

function getFirstValue(
    object,
    keys
) {

    for (
        let i = 0;
        i < keys.length;
        i++
    ) {

        const key =
            keys[i];


        if (
            object &&
            object[key] !== undefined &&
            object[key] !== null &&
            object[key] !== ""
        ) {

            return object[key];

        }

    }


    return "";

}


/* =====================================================
   CLEAN VALUE
   ===================================================== */

function cleanValue(
    value,
    fallback
) {

    if (
        value === undefined ||
        value === null ||
        value === ""
    ) {

        return fallback;

    }


    return String(value);

}


/* =====================================================
   NORMALIZE IMPACT
   ===================================================== */

function normalizeImpact(
    value
) {

    const textValue =
        String(
            value || ""
        )
        .toUpperCase();


    if (
        textValue.includes("HIGH") ||
        textValue.includes("3")
    ) {

        return "HIGH";

    }


    if (
        textValue.includes("MEDIUM") ||
        textValue.includes("MODERATE") ||
        textValue.includes("2")
    ) {

        return "MEDIUM";

    }


    if (
        textValue.includes("LOW") ||
        textValue.includes("1")
    ) {

        return "LOW";

    }


    return "LOW";

}


/* =====================================================
   NORMALIZE DATE
   ===================================================== */

function normalizeDate(
    value
) {

    if (!value) {

        return "";

    }


    const text =
        String(value);


    /*
       Already YYYY-MM-DD
    */

    if (
        /^\d{4}-\d{2}-\d{2}$/.test(
            text
        )
    ) {

        return text;

    }


    const parsed =
        new Date(text);


    if (
        !isNaN(
            parsed.getTime()
        )
    ) {

        return (
            parsed.getFullYear() +
            "-" +
            String(
                parsed.getMonth() + 1
            ).padStart(2, "0") +
            "-" +
            String(
                parsed.getDate()
            ).padStart(2, "0")
        );

    }


    return text;

}


/* =====================================================
   NORMALIZE TIME
   ===================================================== */

function normalizeTime(
    value
) {

    if (!value) {

        return "—";

    }


    const text =
        String(value);


    const match =
        text.match(
            /(\d{1,2}):(\d{2})/
        );


    if (match) {

        return (
            String(
                match[1]
            ).padStart(2, "0") +
            ":" +
            match[2]
        );

    }


    return text;

}


/* =====================================================
   RENDER CALENDAR
   ===================================================== */

function renderEconomicNews(
    events
) {

    const container =
        document.getElementById(
            "economicNewsRows"
        );


    const noNews =
        document.getElementById(
            "noNews"
        );


    const error =
        document.getElementById(
            "newsError"
        );


    error.style.display =
        "none";


    container.innerHTML =
        "";


    if (
        !events ||
        events.length === 0
    ) {

        noNews.style.display =
            "block";

        return;

    }


    noNews.style.display =
        "none";


    events.forEach(
        function(event) {

            const row =
                document.createElement(
                    "div"
                );


            row.className =
                "calendar-row";


            if (
                isPastEvent(event)
            ) {

                row.classList.add(
                    "past-event"
                );

            }


            const impactClass =
                event.impact === "HIGH"
                    ? "impact-high"
                    : event.impact === "MEDIUM"
                        ? "impact-medium"
                        : "impact-low";


            row.innerHTML = `

                <div class="calendar-date">

                    <div class="calendar-date-main">
                        ${formatDate(event.date)}
                    </div>

                </div>


                <div class="calendar-time">
                    ${escapeHtml(event.time)}
                </div>


                <div class="calendar-event">

                    ${escapeHtml(event.event)}

                    <div class="calendar-event-sub">
                        Economic release
                    </div>

                </div>


                <div class="calendar-currency">
                    ${escapeHtml(event.currency)}
                </div>


                <div class="calendar-impact ${impactClass}">

                    <span class="impact-dot"></span>

                    ${event.impact}

                </div>


                <div class="calendar-value actual">
                    ${escapeHtml(event.actual)}
                </div>


                <div class="calendar-value forecast">
                    ${escapeHtml(event.forecast)}
                </div>

            `;


            container.appendChild(
                row
            );

        }
    );

}


/* =====================================================
   FORMAT DATE
   ===================================================== */

function formatDate(
    date
) {

    if (!date) {

        return "—";

    }


    const parts =
        date.split("-");


    if (
        parts.length !== 3
    ) {

        return escapeHtml(
            date
        );

    }


    const year =
        Number(parts[0]);

    const month =
        Number(parts[1]) - 1;

    const day =
        Number(parts[2]);


    const dateObject =
        new Date(
            year,
            month,
            day
        );


    const monthName =
        dateObject.toLocaleString(
            "en-US",
            {
                month: "short"
            }
        );


    return (
        monthName +
        " " +
        day
    );

}


/* =====================================================
   PAST EVENT
   ===================================================== */

function isPastEvent(
    event
) {

    if (!event.date) {

        return false;

    }


    const eventDate =
        new Date(
            event.date +
            "T" +
            (
                event.time !== "—"
                    ? event.time
                    : "23:59"
            )
        );


    return (
        eventDate.getTime() <
        Date.now()
    );

}


/* =====================================================
   ESCAPE HTML
   ===================================================== */

function escapeHtml(
    value
) {

    return String(
        value || ""
    )
    .replace(
        /&/g,
        "&amp;"
    )
    .replace(
        /</g,
        "&lt;"
    )
    .replace(
        />/g,
        "&gt;"
    )
    .replace(
        /"/g,
        "&quot;"
    )
    .replace(
        /'/g,
        "&#039;"
    );

}


/* =====================================================
   SUMMARY
   ===================================================== */

function updateEconomicSummary() {

    let high = 0;

    let medium = 0;

    let low = 0;


    economicNewsData.forEach(
        function(event) {

            if (
                event.impact === "HIGH"
            ) {

                high++;

            }
            else if (
                event.impact === "MEDIUM"
            ) {

                medium++;

            }
            else {

                low++;

            }

        }
    );


    document.getElementById(
        "totalEvents"
    ).textContent =
        economicNewsData.length;


    document.getElementById(
        "highEvents"
    ).textContent =
        high;


    document.getElementById(
        "mediumEvents"
    ).textContent =
        medium;


    document.getElementById(
        "lowEvents"
    ).textContent =
        low;

}


/* =====================================================
   FILTER
   ===================================================== */

function filterEconomicNews() {

    const selectedDate =
        document.getElementById(
            "newsDate"
        ).value;


    const selectedImpact =
        document.getElementById(
            "impactFilter"
        ).value;


    filteredEconomicNews =
        economicNewsData.filter(
            function(event) {

                let dateMatch =
                    true;

                let impactMatch =
                    true;


                if (
                    selectedDate &&
                    event.date !== selectedDate
                ) {

                    dateMatch =
                        false;

                }


                if (
                    selectedImpact !==
                    "ALL" &&
                    event.impact !==
                    selectedImpact
                ) {

                    impactMatch =
                        false;

                }


                return (
                    dateMatch &&
                    impactMatch
                );

            }
        );


    renderEconomicNews(
        filteredEconomicNews
    );


    updateFilterStatus(
        filteredEconomicNews.length
    );


    updateCurrentDateLabel(
        selectedDate
    );

}


/* =====================================================
   FILTER STATUS
   ===================================================== */

function updateFilterStatus(
    count
) {

    const selectedDate =
        document.getElementById(
            "newsDate"
        ).value;


    const selectedImpact =
        document.getElementById(
            "impactFilter"
        ).value;


    let text =
        "Showing " +
        count +
        " economic event";


    if (
        count !== 1
    ) {

        text += "s";

    }


    if (selectedDate) {

        text +=
            " for " +
            formatDate(
                selectedDate
            );

    }
    else {

        text +=
            " across available dates";

    }


    if (
        selectedImpact !== "ALL"
    ) {

        text +=
            " • " +
            selectedImpact +
            " impact";

    }


    document.getElementById(
        "filterStatus"
    ).textContent =
        text;

}


/* =====================================================
   CLEAR FILTERS
   ===================================================== */

function clearNewsFilters() {

    document.getElementById(
        "newsDate"
    ).value =
        "";


    document.getElementById(
        "impactFilter"
    ).value =
        "ALL";


    filteredEconomicNews =
        economicNewsData.slice();


    renderEconomicNews(
        filteredEconomicNews
    );


    updateFilterStatus(
        filteredEconomicNews.length
    );


    updateCurrentDateLabel(
        ""
    );

}


/* =====================================================
   DATE NAVIGATION
   ===================================================== */

function changeNewsDate(
    direction
) {

    const dateInput =
        document.getElementById(
            "newsDate"
        );


    let currentDate;


    if (
        dateInput.value
    ) {

        currentDate =
            new Date(
                dateInput.value +
                "T12:00:00"
            );

    }
    else {

        currentDate =
            new Date();

    }


    currentDate.setDate(
        currentDate.getDate() +
        direction
    );


    const value =
        currentDate.getFullYear() +
        "-" +
        String(
            currentDate.getMonth() + 1
        ).padStart(2, "0") +
        "-" +
        String(
            currentDate.getDate()
        ).padStart(2, "0");


    dateInput.value =
        value;


    filterEconomicNews();

}


/* =====================================================
   TODAY
   ===================================================== */

function setTodayNewsDate() {

    const today =
        new Date();


    const value =
        today.getFullYear() +
        "-" +
        String(
            today.getMonth() + 1
        ).padStart(2, "0") +
        "-" +
        String(
            today.getDate()
        ).padStart(2, "0");


    document.getElementById(
        "newsDate"
    ).value =
        value;


    filterEconomicNews();

}


/* =====================================================
   CURRENT DATE LABEL
   ===================================================== */

function updateCurrentDateLabel(
    date
) {

    const label =
        document.getElementById(
            "currentDateLabel"
        );


    if (!date) {

        label.textContent =
            "ALL DATES";

        return;

    }


    label.textContent =
        formatLongDate(
            date
        );

}


/* =====================================================
   LONG DATE
   ===================================================== */

function formatLongDate(
    date
) {

    if (!date) {

        return "ALL DATES";

    }


    const parts =
        date.split("-");


    if (
        parts.length !== 3
    ) {

        return date;

    }


    const d =
        new Date(
            Number(parts[0]),
            Number(parts[1]) - 1,
            Number(parts[2])
        );


    return d.toLocaleDateString(
        "en-US",
        {
            weekday: "short",
            month: "short",
            day: "numeric",
            year: "numeric"
        }
    );

}


