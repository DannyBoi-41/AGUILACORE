<!DOCTYPE html>
<html lang="en">

<head>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AGUILACORE Dashboard</title>

<style>

/* =====================================================
   GLOBAL
   ===================================================== */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #07111f;
    color: #f5c84c;
    font-family: Arial, Helvetica, sans-serif;
    min-height: 100vh;
}

button,
input,
select {
    font-family: Arial, Helvetica, sans-serif;
}

button {
    outline: none;
}


/* =====================================================
   APP LAYOUT
   ===================================================== */

.app-layout {
    display: flex;
    min-height: 100vh;
}


/* =====================================================
   SIDEBAR
   ===================================================== */

.sidebar {
    width: 240px;
    min-height: 100vh;

    background: #0b1728;

    border-right: 1px solid #c9a227;

    padding: 22px 16px;

    display: flex;
    flex-direction: column;
}

.sidebar-logo {
    color: #f5c84c;

    font-size: 22px;
    font-weight: bold;

    letter-spacing: 2px;
}

.sidebar-subtitle {
    color: #64748b;

    font-size: 10px;

    margin-top: 5px;

    letter-spacing: 1px;
}


/* =====================================================
   MEMBERSHIP
   ===================================================== */

.membership-box {
    margin-top: 25px;

    background: #07111f;

    border: 1px solid #27384e;

    padding: 15px;

    cursor: pointer;

    transition: 0.2s;
}

.membership-box:hover {
    border-color: #c9a227;

    background: #0d1b2e;
}

.membership-label {
    color: #64748b;

    font-size: 10px;

    letter-spacing: 1px;
}

.membership-value {
    color: #53d769;

    font-size: 18px;

    font-weight: bold;

    margin-top: 6px;
}

.membership-action {
    color: #64748b;

    font-size: 9px;

    margin-top: 8px;
}


/* =====================================================
   SIDEBAR MENU
   ===================================================== */

.sidebar-menu {
    margin-top: 25px;
}

.sidebar-item {
    color: #9ba9bb;

    padding: 12px 10px;

    margin-bottom: 4px;

    font-size: 13px;

    border-left: 2px solid transparent;

    cursor: pointer;

    transition: 0.2s;
}

.sidebar-item:hover {
    color: #f5c84c;

    background: #07111f;

    border-left: 2px solid #c9a227;
}

.sidebar-item.active {
    color: #f5c84c;

    background: #07111f;

    border-left: 2px solid #c9a227;
}


/* =====================================================
   ACCOUNT
   ===================================================== */

.sidebar-spacer {
    flex: 1;
}

.sidebar-account {
    border-top: 1px solid #27384e;

    padding-top: 15px;

    margin-top: 20px;
}

.sidebar-account-label {
    color: #64748b;

    font-size: 10px;

    letter-spacing: 1px;

    margin-bottom: 7px;
}

.sidebar-email {
    color: #9ba9bb;

    font-size: 11px;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}


/* =====================================================
   LOGOUT
   ===================================================== */

.sidebar-logout {
    width: 100%;

    margin-top: 12px;

    background: transparent;

    color: #f5c84c;

    border: 1px solid #c9a227;

    padding: 9px;

    cursor: pointer;

    font-size: 11px;

    font-weight: bold;
}

.sidebar-logout:hover {
    background: #c9a227;

    color: #07111f;
}


/* =====================================================
   MAIN CONTENT
   ===================================================== */

.main-content {
    flex: 1;

    min-width: 0;
}


/* =====================================================
   HEADER
   ===================================================== */

.header {
    background: #0b1728;

    border-bottom: 1px solid #27384e;

    padding: 18px 25px;

    display: flex;

    align-items: center;

    justify-content: space-between;
}

.logo {
    font-size: 25px;

    font-weight: bold;

    letter-spacing: 2px;
}

.subtitle {
    color: #9ba9bb;

    font-size: 12px;

    margin-top: 5px;

    letter-spacing: 1px;
}

.user-area {
    display: flex;

    align-items: center;

    gap: 15px;
}

.online {
    color: #53d769;

    font-size: 12px;

    font-weight: bold;
}


/* =====================================================
   CONTAINER
   ===================================================== */

.container {
    padding: 25px;
}


/* =====================================================
   PAGE SYSTEM
   ===================================================== */

.page {
    display: none;
}

.page.active {
    display: block;
}


/* =====================================================
   WELCOME
   ===================================================== */

.welcome {
    background: #0b1728;

    border: 1px solid #27384e;

    padding: 25px;

    margin-bottom: 20px;
}

.welcome-title {
    font-size: 24px;

    font-weight: bold;

    margin-bottom: 8px;
}

.welcome-text {
    color: #9ba9bb;

    font-size: 13px;
}


/* =====================================================
   DASHBOARD CARDS
   ===================================================== */

.dashboard-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 15px;
}

.card {
    background: #0b1728;

    border: 1px solid #27384e;

    padding: 22px;

    min-height: 140px;
}

.card-title {
    color: #9ba9bb;

    font-size: 12px;

    font-weight: bold;

    letter-spacing: 1px;

    margin-bottom: 15px;
}

.card-value {
    color: #f5c84c;

    font-size: 22px;

    font-weight: bold;
}

.card-description {
    color: #64748b;

    font-size: 11px;

    margin-top: 10px;
}


/* =====================================================
   ACCOUNT
   ===================================================== */

.account-box {
    margin-top: 20px;

    background: #0b1728;

    border: 1px solid #27384e;

    padding: 22px;
}

.account-title {
    color: #f5c84c;

    font-size: 16px;

    font-weight: bold;

    margin-bottom: 15px;
}

.account-row {
    display: flex;

    justify-content: space-between;

    border-bottom: 1px solid #17283d;

    padding: 10px 0;

    font-size: 13px;
}

.account-label {
    color: #9ba9bb;
}

.account-value {
    color: white;
}


/* =====================================================
   PAGE TITLES
   ===================================================== */

.page-title {
    color: #f5c84c;

    font-size: 24px;

    font-weight: bold;

    margin-bottom: 8px;
}

.page-description {
    color: #9ba9bb;

    font-size: 13px;

    margin-bottom: 20px;
}


/* =====================================================
   MARKETS
   ===================================================== */

.markets-box {
    background: #0b1728;

    border: 1px solid #27384e;

    padding: 22px;
}

.market-list {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 12px;
}

.market-item {
    background: #07111f;

    border: 1px solid #27384e;

    padding: 16px;

    color: #f5c84c;

    font-weight: bold;

    font-size: 13px;

    cursor: pointer;
}

.market-item:hover {
    border-color: #c9a227;
}


/* =====================================================
   MEMBERSHIP PAGE
   ===================================================== */

.membership-page-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 15px;
}

.membership-card {
    background: #0b1728;

    border: 1px solid #27384e;

    padding: 22px;

    text-align: center;
}

.membership-card:hover {
    border-color: #c9a227;
}

.membership-card-title {
    color: #9ba9bb;

    font-size: 13px;

    font-weight: bold;

    margin-bottom: 15px;
}

.membership-price {
    color: #f5c84c;

    font-size: 25px;

    font-weight: bold;
}

.membership-card-description {
    color: #64748b;

    font-size: 11px;

    margin-top: 10px;
}

.membership-button {
    margin-top: 18px;

    width: 100%;

    padding: 10px;

    background: transparent;

    color: #f5c84c;

    border: 1px solid #c9a227;

    cursor: pointer;
}

.membership-button:hover {
    background: #c9a227;

    color: #07111f;
}


/* =====================================================
   GENERIC CONTENT
   ===================================================== */

.content-box {
    background: #0b1728;

    border: 1px solid #27384e;

    padding: 25px;
}

.content-title {
    color: #f5c84c;

    font-size: 18px;

    font-weight: bold;

    margin-bottom: 10px;
}

.content-text {
    color: #9ba9bb;

    font-size: 13px;

    line-height: 1.6;
}


/* =====================================================
   ECONOMIC NEWS - AGUILACORE
   ===================================================== */

.economic-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 20px;
}

.economic-status {
    display: flex;

    align-items: center;

    gap: 8px;

    color: #53d769;

    font-size: 10px;

    font-weight: bold;

    letter-spacing: 1px;
}

.live-dot {
    width: 7px;

    height: 7px;

    background: #53d769;

    border-radius: 50%;

    box-shadow: 0 0 8px rgba(83,215,105,.7);
}


/* =====================================================
   ECONOMIC SUMMARY
   ===================================================== */

.economic-summary {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 12px;

    margin-bottom: 18px;
}

.summary-card {
    background: #0b1728;

    border: 1px solid #27384e;

    padding: 15px 16px;

    min-height: 82px;
}

.summary-label {
    color: #64748b;

    font-size: 9px;

    letter-spacing: 1px;

    font-weight: bold;
}

.summary-value {
    color: #f5c84c;

    font-size: 21px;

    font-weight: bold;

    margin-top: 8px;
}

.summary-value.high {
    color: #ff5d5d;
}

.summary-value.medium {
    color: #f5c84c;
}

.summary-value.low {
    color: #53d769;
}


/* =====================================================
   FILTER PANEL
   ===================================================== */

.news-filter-box {
    background: #0b1728;

    border: 1px solid #27384e;

    padding: 16px;

    margin-bottom: 15px;

    display: flex;

    align-items: flex-end;

    gap: 12px;

    flex-wrap: wrap;
}

.filter-group {
    display: flex;

    flex-direction: column;

    gap: 6px;
}

.filter-label {
    color: #64748b;

    font-size: 9px;

    font-weight: bold;

    letter-spacing: 1px;
}

.filter-control {
    height: 38px;

    background: #07111f;

    color: #f1f5f9;

    border: 1px solid #27384e;

    padding: 0 11px;

    min-width: 155px;

    font-size: 12px;

    outline: none;
}

.filter-control:focus {
    border-color: #c9a227;
}

.filter-button {
    height: 38px;

    background: #c9a227;

    color: #07111f;

    border: 1px solid #c9a227;

    padding: 0 17px;

    cursor: pointer;

    font-size: 10px;

    font-weight: bold;

    letter-spacing: .5px;
}

.filter-button:hover {
    background: #f5c84c;
}

.filter-clear {
    background: transparent;

    color: #9ba9bb;

    border-color: #27384e;
}

.filter-clear:hover {
    background: #17283d;

    color: white;
}


/* =====================================================
   DATE NAVIGATION
   ===================================================== */

.date-navigation {
    background: #0b1728;

    border: 1px solid #27384e;

    margin-bottom: 15px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 12px 15px;
}

.date-nav-left {
    display: flex;

    align-items: center;

    gap: 8px;
}

.date-nav-button {
    width: 32px;

    height: 30px;

    background: #07111f;

    color: #9ba9bb;

    border: 1px solid #27384e;

    cursor: pointer;

    font-size: 14px;
}

.date-nav-button:hover {
    color: #f5c84c;

    border-color: #c9a227;
}

.current-date-label {
    color: #f5c84c;

    font-size: 13px;

    font-weight: bold;

    min-width: 180px;

    text-align: center;
}

.date-nav-right {
    color: #64748b;

    font-size: 10px;

    letter-spacing: .5px;
}


/* =====================================================
   FILTER STATUS
   ===================================================== */

.filter-status {
    color: #64748b;

    font-size: 10px;

    margin-bottom: 10px;
}


/* =====================================================
   AGUILACORE ECONOMIC CALENDAR
   ===================================================== */

.economic-calendar {
    background: #0b1728;

    border: 1px solid #27384e;

    overflow: hidden;
}


/* =====================================================
   CALENDAR TABLE HEADER
   ===================================================== */

.calendar-header {
    display: grid;

    grid-template-columns:
        90px
        70px
        minmax(260px, 1fr)
        85px
        95px
        95px
        95px;

    background: #0e1b2d;

    border-bottom: 1px solid #c9a227;

    padding: 11px 14px;

    color: #64748b;

    font-size: 9px;

    font-weight: bold;

    letter-spacing: 1px;
}


/* =====================================================
   CALENDAR ROW
   ===================================================== */

.calendar-row {
    display: grid;

    grid-template-columns:
        90px
        70px
        minmax(260px, 1fr)
        85px
        95px
        95px
        95px;

    padding: 13px 14px;

    border-bottom: 1px solid #17283d;

    align-items: center;

    font-size: 11px;

    transition: background .15s;
}

.calendar-row:hover {
    background: #0d1b2e;
}


/* =====================================================
   DATE
   ===================================================== */

.calendar-date {
    color: #64748b;

    font-size: 10px;

    line-height: 1.4;
}

.calendar-date-main {
    color: #9ba9bb;

    font-weight: bold;
}


/* =====================================================
   TIME
   ===================================================== */

.calendar-time {
    color: #f5c84c;

    font-size: 11px;

    font-weight: bold;
}


/* =====================================================
   EVENT
   ===================================================== */

.calendar-event {
    color: #f1f5f9;

    font-size: 12px;

    font-weight: bold;

    padding-right: 15px;
}

.calendar-event-sub {
    color: #64748b;

    font-size: 9px;

    margin-top: 4px;
}


/* =====================================================
   CURRENCY
   ===================================================== */

.calendar-currency {
    color: #f5c84c;

    font-size: 11px;

    font-weight: bold;

    text-align: center;
}


/* =====================================================
   IMPACT
   ===================================================== */

.calendar-impact {
    display: flex;

    align-items: center;

    gap: 5px;

    font-size: 9px;

    font-weight: bold;

    text-transform: uppercase;
}

.impact-dot {
    width: 7px;

    height: 7px;

    border-radius: 50%;

    flex-shrink: 0;
}

.impact-high {
    color: #ff5d5d;
}

.impact-high .impact-dot {
    background: #ff5d5d;

    box-shadow: 0 0 6px rgba(255,93,93,.5);
}

.impact-medium {
    color: #f5c84c;
}

.impact-medium .impact-dot {
    background: #f5c84c;

    box-shadow: 0 0 6px rgba(245,200,76,.4);
}

.impact-low {
    color: #53d769;
}

.impact-low .impact-dot {
    background: #53d769;
}


/* =====================================================
   DATA CELLS
   ===================================================== */

.calendar-value {
    color: #9ba9bb;

    font-size: 11px;

    font-weight: bold;
}

.calendar-value.actual {
    color: white;
}

.calendar-value.forecast {
    color: #64748b;
}

.calendar-value.previous {
    color: #64748b;
}


/* =====================================================
   PAST EVENT
   ===================================================== */

.calendar-row.past-event {
    opacity: .72;
}

.calendar-row.past-event:hover {
    opacity: 1;
}


/* =====================================================
   NO NEWS
   ===================================================== */

.no-news {
    padding: 50px 20px;

    text-align: center;

    color: #64748b;

    font-size: 12px;
}

.no-news-title {
    color: #9ba9bb;

    font-size: 14px;

    font-weight: bold;

    margin-bottom: 7px;
}


/* =====================================================
   LOADING
   ===================================================== */

.news-loading {
    padding: 50px 20px;

    text-align: center;

    color: #64748b;

    font-size: 12px;
}

.loading-spinner {
    width: 22px;

    height: 22px;

    border: 2px solid #27384e;

    border-top-color: #f5c84c;

    border-radius: 50%;

    margin: 0 auto 12px;

    animation:
        newsSpin .8s linear infinite;
}

@keyframes newsSpin {

    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }

}


/* =====================================================
   ERROR
   ===================================================== */

.news-error {
    padding: 35px 20px;

    text-align: center;

    color: #ff5d5d;

    font-size: 12px;
}

.news-error-title {
    color: #ff5d5d;

    font-weight: bold;

    margin-bottom: 7px;
}


/* =====================================================
   SOURCE NOTE
   ===================================================== */

.calendar-footer {
    padding: 10px 14px;

    background: #0e1b2d;

    border-top: 1px solid #17283d;

    color: #475569;

    font-size: 9px;

    text-align: right;
}


/* =====================================================
   FOOTER
   ===================================================== */

.footer {
    text-align: center;

    color: #64748b;

    font-size: 11px;

    padding: 25px;
}


/* =====================================================
   RESPONSIVE
   ===================================================== */

@media (max-width: 1200px) {

    .calendar-header,
    .calendar-row {
        grid-template-columns:
            80px
            65px
            minmax(220px, 1fr)
            75px
            85px
            85px
            85px;
    }

    .economic-summary {
        grid-template-columns:
            repeat(2, 1fr);
    }

}


@media (max-width: 1000px) {

    .membership-page-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .market-list {
        grid-template-columns:
            repeat(2, 1fr);
    }

}


@media (max-width: 800px) {

    .sidebar {
        width: 200px;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .container {
        padding: 15px;
    }

    .header {
        padding: 15px;
    }

    .online {
        display: none;
    }

    .economic-summary {
        grid-template-columns: 1fr;
    }

    .economic-calendar {
        overflow-x: auto;
    }

    .calendar-header,
    .calendar-row {
        min-width: 760px;
    }

}


@media (max-width: 600px) {

    .app-layout {
        display: block;
    }

    .sidebar {
        width: 100%;

        min-height: auto;

        border-right: none;

        border-bottom: 1px solid #c9a227;
    }

    .sidebar-spacer {
        display: none;
    }

    .membership-page-grid {
        grid-template-columns: 1fr;
    }

    .market-list {
        grid-template-columns: 1fr;
    }

    .economic-header {
        display: block;
    }

    .economic-status {
        margin-top: 10px;
    }

    .news-filter-box {
        align-items: stretch;
    }

    .filter-group,
    .filter-control,
    .filter-button {
        width: 100%;
    }

    .date-navigation {
        display: block;
    }

    .date-nav-left {
        justify-content: center;
    }

    .date-nav-right {
        text-align: center;

        margin-top: 10px;
    }

}


/* =====================================================
   HIDE NATIVE DATE ICON COLOR ISSUE
   ===================================================== */

input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(1);
    opacity: .7;
}

</style>

</head>


<body>

<div class="app-layout">


<!-- =====================================================
     SIDEBAR
     ===================================================== -->

<aside class="sidebar">

    <div>

        <div class="sidebar-logo">
            AGUILACORE
        </div>

        <div class="sidebar-subtitle">
            TRADING PLATFORM
        </div>

    </div>


    <div
        class="membership-box"
        onclick="showPage('membershipPage')">

        <div class="membership-label">
            MEMBERSHIP
        </div>

        <div
            class="membership-value"
            id="sidebarMembership">

            FREE

        </div>

        <div class="membership-action">
            VIEW MEMBERSHIP PLANS →
        </div>

    </div>


    <div class="sidebar-menu">

        <div
            class="sidebar-item active"
            id="dashboardMenu"
            onclick="showPage('dashboardPage')">

            ▣ &nbsp; Dashboard

        </div>


        <div
            class="sidebar-item"
            id="marketsMenu"
            onclick="showPage('marketsPage')">

            ◉ &nbsp; Markets

        </div>


        <div
            class="sidebar-item"
            id="signalsMenu"
            onclick="showPage('signalsPage')">

            ◇ &nbsp; Signals

        </div>


        <div
            class="sidebar-item"
            id="goldMenu"
            onclick="showPage('goldPage')">

            ◎ &nbsp; Gold / XAUUSD

        </div>


        <div
            class="sidebar-item"
            id="economicNewsMenu"
            onclick="showPage('economicNewsPage')">

            ◉ &nbsp; Economic News

        </div>

    </div>


    <div class="sidebar-spacer"></div>


    <div class="sidebar-account">

        <div class="sidebar-account-label">
            ACCOUNT
        </div>

        <div
            class="sidebar-email"
            id="sidebarEmail">

            Loading...

        </div>

        <button
            class="sidebar-logout"
            onclick="logoutUser()">

            LOGOUT

        </button>

    </div>

</aside>


<!-- =====================================================
     MAIN CONTENT
     ===================================================== -->

<div class="main-content">


<div class="header">

    <div>

        <div class="logo">
            AGUILACORE
        </div>

        <div class="subtitle">
            TRADING PLATFORM • DASHBOARD
        </div>

    </div>


    <div class="user-area">

        <div class="online">
            ● ONLINE
        </div>

    </div>

</div>


<div class="container">


<!-- =====================================================
     DASHBOARD
     ===================================================== -->

<div
    class="page active"
    id="dashboardPage">

    <div class="welcome">

        <div class="welcome-title">
            Welcome to AGUILACORE
        </div>

        <div class="welcome-text">
            Your trading terminal is ready.
        </div>

    </div>


    <div class="dashboard-grid">


        <div class="card">

            <div class="card-title">
                ACCOUNT
            </div>

