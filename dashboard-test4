<!DOCTYPE html>
<html lang="en">

<head>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AGUILACORE Trading Platform</title>

<style>

/* =====================================================
   GLOBAL
   ===================================================== */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: #07111f;
    color: #f5c84c;
    font-family: Arial, Helvetica, sans-serif;
    min-height: 100vh;
}

button,
input,
select {
    font-family: Arial, Helvetica, sans-serif;
}

button {
    outline: none;
}

.app-layout {
    display: flex;
    min-height: 100vh;
}

/* =====================================================
   SIDEBAR
   ===================================================== */

.sidebar {
    width: 240px;
    min-height: 100vh;
    background: #0b1728;
    border-right: 1px solid #c9a227;
    padding: 22px 16px;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
}

.sidebar-logo {
    color: #f5c84c;
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 2px;
}

.sidebar-subtitle {
    color: #64748b;
    font-size: 10px;
    margin-top: 5px;
    letter-spacing: 1px;
}

.membership-box {
    margin-top: 25px;
    background: #07111f;
    border: 1px solid #27384e;
    padding: 15px;
    cursor: pointer;
    transition: 0.2s;
}

.membership-box:hover {
    border-color: #c9a227;
    background: #0d1b2e;
}

.membership-label {
    color: #64748b;
    font-size: 10px;
    letter-spacing: 1px;
}

.membership-value {
    color: #53d769;
    font-size: 18px;
    font-weight: bold;
    margin-top: 6px;
}

.membership-action {
    color: #64748b;
    font-size: 9px;
    margin-top: 8px;
}

.sidebar-menu {
    margin-top: 25px;
}

.sidebar-item {
    color: #9ba9bb;
    padding: 12px 10px;
    margin-bottom: 4px;
    font-size: 13px;
    border-left: 2px solid transparent;
    cursor: pointer;
    transition: 0.2s;
}

.sidebar-item:hover,
.sidebar-item.active {
    color: #f5c84c;
    background: #07111f;
    border-left: 2px solid #c9a227;
}

.sidebar-spacer {
    flex: 1;
}

.sidebar-account {
    border-top: 1px solid #27384e;
    padding-top: 15px;
    margin-top: 20px;
}

.sidebar-account-label {
    color: #64748b;
    font-size: 10px;
    letter-spacing: 1px;
    margin-bottom: 7px;
}

.sidebar-email {
    color: #9ba9bb;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sidebar-logout {
    width: 100%;
    margin-top: 12px;
    background: transparent;
    color: #f5c84c;
    border: 1px solid #c9a227;
    padding: 9px;
    cursor: pointer;
    font-size: 11px;
    font-weight: bold;
}

.sidebar-logout:hover {
    background: #c9a227;
    color: #07111f;
}

/* =====================================================
   MAIN
   ===================================================== */

.main-content {
    flex: 1;
    min-width: 0;
}

.header {
    background: #0b1728;
    border-bottom: 1px solid #27384e;
    padding: 18px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    letter-spacing: 2px;
}

.subtitle {
    color: #9ba9bb;
    font-size: 12px;
    margin-top: 5px;
    letter-spacing: 1px;
}

.user-area {
    display: flex;
    align-items: center;
    gap: 15px;
}

.online {
    color: #53d769;
    font-size: 12px;
    font-weight: bold;
}

.container {
    padding: 25px;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

/* =====================================================
   COMMON
   ===================================================== */

.page-title {
    color: #f5c84c;
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 8px;
}

.page-description {
    color: #9ba9bb;
    font-size: 13px;
    margin-bottom: 20px;
}

.content-box,
.card,
.account-box,
.markets-box,
.membership-card,
.news-control-panel,
.aguilacore-calendar,
.signal-panel,
.gold-panel,
.cot-panel {
    background: #0b1728;
    border: 1px solid #27384e;
}

.welcome {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 25px;
    margin-bottom: 20px;
}

.welcome-title {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 8px;
}

.welcome-text {
    color: #9ba9bb;
    font-size: 13px;
}

/* =====================================================
   DASHBOARD
   ===================================================== */

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.card {
    padding: 22px;
    min-height: 140px;
}

.card-title {
    color: #9ba9bb;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

.card-value {
    color: #f5c84c;
    font-size: 22px;
    font-weight: bold;
}

.card-description {
    color: #64748b;
    font-size: 11px;
    margin-top: 10px;
}

.account-box {
    margin-top: 20px;
    padding: 22px;
}

.account-title {
    color: #f5c84c;
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 15px;
}

.account-row {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #17283d;
    padding: 10px 0;
    font-size: 13px;
}

.account-label {
    color: #9ba9bb;
}

.account-value {
    color: white;
}

/* =====================================================
   MARKETS
   ===================================================== */

.markets-box {
    padding: 22px;
}

.market-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.market-item {
    background: #07111f;
    border: 1px solid #27384e;
    padding: 16px;
    color: #f5c84c;
    font-weight: bold;
    font-size: 13px;
    cursor: pointer;
}

.market-item:hover {
    border-color: #c9a227;
    background: #0d1b2e;
}

.market-price {
    display: block;
    color: #64748b;
    font-size: 10px;
    margin-top: 6px;
}

/* =====================================================
   GENERIC
   ===================================================== */

.content-box {
    padding: 25px;
}

.content-title {
    color: #f5c84c;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 10px;
}

.content-text {
    color: #9ba9bb;
    font-size: 13px;
    line-height: 1.6;
}

/* =====================================================
   SIGNALS
   ===================================================== */

.signal-overview {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 20px;
}

.signal-card {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 20px;
}

.signal-label {
    color: #64748b;
    font-size: 10px;
    letter-spacing: 1px;
}

.signal-value {
    margin-top: 9px;
    color: #f5c84c;
    font-size: 20px;
    font-weight: bold;
}

.signal-value.buy {
    color: #53d769;
}

.signal-value.sell {
    color: #ff6262;
}

.signal-value.wait {
    color: #f5c84c;
}

.signal-panel {
    padding: 20px;
}

.signal-table {
    width: 100%;
    border-collapse: collapse;
}

.signal-table th {
    color: #64748b;
    font-size: 9px;
    text-align: left;
    letter-spacing: 1px;
    padding: 12px;
    border-bottom: 1px solid #27384e;
}

.signal-table td {
    color: #d7dee8;
    font-size: 12px;
    padding: 13px 12px;
    border-bottom: 1px solid #17283d;
}

.signal-status {
    font-weight: bold;
}

.signal-status.buy {
    color: #53d769;
}

.signal-status.sell {
    color: #ff6262;
}

.signal-status.wait {
    color: #f5c84c;
}

/* =====================================================
   GOLD
   ===================================================== */

.gold-overview {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 15px;
    margin-bottom: 20px;
}

.gold-price-card,
.gold-stat-card {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 22px;
}

.gold-symbol {
    color: #64748b;
    font-size: 10px;
    letter-spacing: 1px;
}

.gold-price {
    color: #f5c84c;
    font-size: 32px;
    font-weight: bold;
    margin-top: 8px;
}

.gold-stat-label {
    color: #64748b;
    font-size: 10px;
}

.gold-stat-value {
    color: white;
    font-size: 18px;
    font-weight: bold;
    margin-top: 8px;
}

.gold-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.gold-panel {
    padding: 22px;
}

.panel-title {
    color: #f5c84c;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 1px;
    margin-bottom: 16px;
}

.bias-box {
    border: 1px solid #27384e;
    background: #07111f;
    padding: 20px;
    text-align: center;
}

.bias-value {
    font-size: 28px;
    font-weight: bold;
}

.bias-value.buy {
    color: #53d769;
}

.bias-value.sell {
    color: #ff6262;
}

.bias-value.wait {
    color: #f5c84c;
}

.analysis-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.analysis-list li {
    display: flex;
    justify-content: space-between;
    padding: 11px 0;
    border-bottom: 1px solid #17283d;
    font-size: 12px;
}

.analysis-label {
    color: #64748b;
}

.analysis-value {
    color: white;
    font-weight: bold;
}

/* =====================================================
   COT
   ===================================================== */

.cot-overview {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 20px;
}

.cot-stat {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 20px;
}

.cot-stat-label {
    color: #64748b;
    font-size: 10px;
    letter-spacing: 1px;
}

.cot-stat-value {
    color: #f5c84c;
    font-size: 20px;
    font-weight: bold;
    margin-top: 8px;
}

.cot-panel {
    padding: 20px;
    margin-bottom: 15px;
}

.cot-table {
    width: 100%;
    border-collapse: collapse;
}

.cot-table th {
    color: #64748b;
    text-align: left;
    font-size: 9px;
    letter-spacing: 1px;
    padding: 12px;
    border-bottom: 1px solid #27384e;
}

.cot-table td {
    color: #d7dee8;
    font-size: 12px;
    padding: 12px;
    border-bottom: 1px solid #17283d;
}

.cot-positive {
    color: #53d769 !important;
    font-weight: bold;
}

.cot-negative {
    color: #ff6262 !important;
    font-weight: bold;
}

.cot-neutral {
    color: #f5c84c !important;
    font-weight: bold;
}

.cot-note {
    margin-top: 15px;
    color: #64748b;
    font-size: 10px;
    line-height: 1.5;
}

/* =====================================================
   MEMBERSHIP
   ===================================================== */

.membership-page-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.membership-card {
    padding: 22px;
    text-align: center;
}

.membership-card:hover {
    border-color: #c9a227;
}

.membership-card-title {
    color: #9ba9bb;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 15px;
}

.membership-price {
    color: #f5c84c;
    font-size: 25px;
    font-weight: bold;
}

.membership-card-description {
    color: #64748b;
    font-size: 11px;
    margin-top: 10px;
}

.membership-button {
    margin-top: 18px;
    width: 100%;
    padding: 10px;
    background: transparent;
    color: #f5c84c;
    border: 1px solid #c9a227;
    cursor: pointer;
}

.membership-button:hover {
    background: #c9a227;
    color: #07111f;
}

/* =====================================================
   ECONOMIC NEWS
   ===================================================== */

.economic-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.economic-status {
    color: #53d769;
    font-size: 11px;
    font-weight: bold;
}

.news-control-panel {
    padding: 18px;
    margin-bottom: 18px;
}

.news-controls {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
}

.news-control {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.news-control label {
    color: #64748b;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 1px;
}

.news-control input,
.news-control select {
    background: #07111f;
    color: white;
    border: 1px solid #27384e;
    height: 38px;
    padding: 0 11px;
    min-width: 155px;
    outline: none;
}

.news-control input:focus,
.news-control select:focus {
    border-color: #c9a227;
}

.news-button {
    height: 38px;
    padding: 0 18px;
    border: 1px solid #c9a227;
    background: transparent;
    color: #f5c84c;
    cursor: pointer;
    font-size: 10px;
    font-weight: bold;
}

.news-button:hover {
    background: #c9a227;
    color: #07111f;
}

.news-button.secondary {
    border-color: #27384e;
    color: #9ba9bb;
}

.news-button.secondary:hover {
    background: #27384e;
    color: white;
}

.news-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 12px;
    color: #64748b;
    font-size: 11px;
}

.news-count {
    color: #f5c84c;
    font-weight: bold;
}

.news-updated {
    color: #64748b;
}

.aguilacore-calendar {
    overflow: hidden;
}

.calendar-titlebar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    background: #0d1b2e;
    border-bottom: 1px solid #27384e;
}

.calendar-title {
    color: #f5c84c;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 1px;
}

.calendar-timezone {
    color: #64748b;
    font-size: 10px;
}

.calendar-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
}

.calendar-table thead {
    background: #101e31;
}

.calendar-table th {
    text-align: left;
    color: #64748b;
    font-size: 9px;
    letter-spacing: 1px;
    padding: 13px 12px;
    border-bottom: 1px solid #27384e;
}

.calendar-table td {
    padding: 13px 12px;
    border-bottom: 1px solid #17283d;
    color: #d7dee8;
    font-size: 12px;
    vertical-align: middle;
}

.calendar-table tbody tr:hover {
    background: #0d1b2e;
}

.calendar-table th:nth-child(1),
.calendar-table td:nth-child(1) {
    width: 90px;
}

.calendar-table th:nth-child(2),
.calendar-table td:nth-child(2) {
    width: 85px;
}

.calendar-table th:nth-child(3),
.calendar-table td:nth-child(3) {
    width: auto;
}

.calendar-table th:nth-child(4),
.calendar-table td:nth-child(4) {
    width: 85px;
}

.calendar-table th:nth-child(5),
.calendar-table td:nth-child(5) {
    width: 100px;
}

.calendar-table th:nth-child(6),
.calendar-table td:nth-child(6) {
    width: 100px;
}

.calendar-table th:nth-child(7),
.calendar-table td:nth-child(7) {
    width: 100px;
}

.calendar-table th:nth-child(8),
.calendar-table td:nth-child(8) {
    width: 100px;
}

.event-name {
    color: white;
    font-weight: bold;
}

.currency-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    padding: 5px 7px;
    background: #07111f;
    border: 1px solid #27384e;
    color: #f5c84c;
    font-size: 10px;
    font-weight: bold;
}

.impact-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: bold;
}

.impact-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
}

.impact-high {
    color: #ff6262;
}

.impact-high .impact-dot {
    background: #ff5555;
}

.impact-medium {
    color: #f5c84c;
}

.impact-medium .impact-dot {
    background: #f5c84c;
}

.impact-low {
    color: #53d769;
}

.impact-low .impact-dot {
    background: #53d769;
}

.actual-value {
    color: #53d769;
    font-weight: bold;
}

.forecast-value {
    color: #9ba9bb;
}

.previous-value {
    color: #64748b;
}

.past-event {
    opacity: 0.72;
}

.news-loading {
    padding: 45px 20px;
    text-align: center;
    color: #64748b;
    font-size: 12px;
}

.news-loading strong {
    display: block;
    color: #f5c84c;
    margin-bottom: 7px;
    font-size: 13px;
}

.news-empty {
    display: none;
    padding: 45px 20px;
    text-align: center;
    color: #64748b;
    font-size: 12px;
}

.news-empty strong {
    display: block;
    color: #f5c84c;
    margin-bottom: 7px;
}

.news-error {
    display: none;
    padding: 18px;
    margin-bottom: 15px;
    background: #21131a;
    border: 1px solid #5c2733;
    color: #ff8b8b;
    font-size: 11px;
}

/* =====================================================
   FOOTER
   ===================================================== */

.footer {
    text-align: center;
    color: #64748b;
    font-size: 11px;
    padding: 25px;
}

/* =====================================================
   RESPONSIVE
   ===================================================== */

@media (max-width: 1200px) {

    .market-list {
        grid-template-columns: repeat(3, 1fr);
    }

    .membership-page-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .gold-overview {
        grid-template-columns: repeat(2, 1fr);
    }

    .signal-overview,
    .cot-overview {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 900px) {

    .sidebar {
        width: 210px;
    }

    .calendar-table {
        min-width: 800px;
    }

    .aguilacore-calendar {
        overflow-x: auto;
    }

    .gold-grid {
        grid-template-columns: 1fr;
    }

}

@media (max-width: 800px) {

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .market-list {
        grid-template-columns: repeat(2, 1fr);
    }

    .container {
        padding: 15px;
    }

    .header {
        padding: 15px;
    }

    .online {
        display: none;
    }

}

@media (max-width: 600px) {

    .app-layout {
        display: block;
    }

    .sidebar {
        width: 100%;
        min-height: auto;
        height: auto;
        position: relative;
        border-right: none;
        border-bottom: 1px solid #c9a227;
    }

    .sidebar-spacer {
        display: none;
    }

    .membership-page-grid,
    .signal-overview,
    .cot-overview,
    .gold-overview,
    .market-list {
        grid-template-columns: 1fr;
    }

    .economic-header {
        display: block;
    }

    .economic-status {
        margin-top: 10px;
    }

    .news-controls {
        flex-direction: column;
        align-items: stretch;
    }

    .news-control input,
    .news-control select,
    .news-button {
        width: 100%;
    }

    .account-row {
        gap: 15px;
        flex-direction: column;
    }

}

</style>

</head>

<body>

<div class="app-layout">

<!-- =====================================================
     SIDEBAR
     ===================================================== -->

<aside class="sidebar">

    <div>

        <div class="sidebar-logo">
            AGUILACORE
        </div>

        <div class="sidebar-subtitle">
            TRADING PLATFORM
        </div>

    </div>


    <div
        class="membership-box"
        onclick="showPage('membershipPage')">

        <div class="membership-label">
            MEMBERSHIP
        </div>

        <div
            class="membership-value"
            id="sidebarMembership">
            FREE
        </div>

        <div class="membership-action">
            VIEW MEMBERSHIP PLANS →
        </div>

    </div>


    <div class="sidebar-menu">

        <div
            class="sidebar-item active"
            id="dashboardMenu"
            onclick="showPage('dashboardPage')">

            ▣ &nbsp; Dashboard

        </div>

        <div
            class="sidebar-item"
            id="marketsMenu"
            onclick="showPage('marketsPage')">

            ◉ &nbsp; Markets

        </div>

        <div
            class="sidebar-item"
            id="signalsMenu"
            onclick="showPage('signalsPage')">

            ◇ &nbsp; Signals

        </div>

        <div
            class="sidebar-item"
            id="goldMenu"
