   ===================================================== */

function showPage(pageId) {

    const pages =
        document.querySelectorAll(
            ".page"
        );

    pages.forEach(
        function(page) {

            page.classList.remove(
                "active"
            );

        }
    );


    const selectedPage =
        document.getElementById(
            pageId
        );


    if (selectedPage) {

        selectedPage.classList.add(
            "active"
        );

    }


    const menuItems =
        document.querySelectorAll(
            ".sidebar-item"
        );


    menuItems.forEach(
        function(item) {

            item.classList.remove(
                "active"
            );

        }
    );


    const menuMap = {

        dashboardPage:
            "dashboardMenu",

        marketsPage:
            "marketsMenu",

        signalsPage:
            "signalsMenu",

        goldPage:
            "goldMenu",

        economicNewsPage:
            "economicNewsMenu",

        cotPage:
            "cotMenu"

    };


    if (
        menuMap[pageId]
    ) {

        const menu =
            document.getElementById(
                menuMap[pageId]
            );

        if (menu) {

            menu.classList.add(
                "active"
            );

        }

    }


    if (
        pageId ===
        "economicNewsPage"
