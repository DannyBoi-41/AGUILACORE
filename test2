<!DOCTYPE html>
<html lang="en">

<head>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AGUILACORE Dashboard</title>

<style>

/* =====================================================
   GLOBAL
   ===================================================== */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #07111f;
    color: #f5c84c;
    font-family: Arial, Helvetica, sans-serif;
    min-height: 100vh;
}

button,
input,
select {
    font-family: Arial, Helvetica, sans-serif;
}


/* =====================================================
   APP LAYOUT
   ===================================================== */

.app-layout {
    display: flex;
    min-height: 100vh;
}


/* =====================================================
   LEFT SIDEBAR
   ===================================================== */

.sidebar {
    width: 240px;
    min-height: 100vh;
    background: #0b1728;
    border-right: 1px solid #c9a227;
    padding: 22px 16px;
    display: flex;
    flex-direction: column;
}

.sidebar-logo {
    color: #f5c84c;
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 2px;
}

.sidebar-subtitle {
    color: #64748b;
    font-size: 10px;
    margin-top: 5px;
    letter-spacing: 1px;
}


/* =====================================================
   MEMBERSHIP
   ===================================================== */

.membership-box {
    margin-top: 25px;
    background: #07111f;
    border: 1px solid #27384e;
    padding: 15px;
    cursor: pointer;
    transition: 0.2s;
}

.membership-box:hover {
    border-color: #c9a227;
    background: #0d1b2e;
}

.membership-label {
    color: #64748b;
    font-size: 10px;
    letter-spacing: 1px;
}

.membership-value {
    color: #53d769;
    font-size: 18px;
    font-weight: bold;
    margin-top: 6px;
}

.membership-action {
    color: #64748b;
    font-size: 9px;
    margin-top: 8px;
}


/* =====================================================
   SIDEBAR MENU
   ===================================================== */

.sidebar-menu {
    margin-top: 25px;
}

.sidebar-item {
    color: #9ba9bb;
    padding: 12px 10px;
    margin-bottom: 4px;
    font-size: 13px;
    border-left: 2px solid transparent;
    cursor: pointer;
    transition: 0.2s;
}

.sidebar-item:hover {
    color: #f5c84c;
    background: #07111f;
    border-left: 2px solid #c9a227;
}

.sidebar-item.active {
    color: #f5c84c;
    background: #07111f;
    border-left: 2px solid #c9a227;
}


/* =====================================================
   SIDEBAR ACCOUNT
   ===================================================== */

.sidebar-spacer {
    flex: 1;
}

.sidebar-account {
    border-top: 1px solid #27384e;
    padding-top: 15px;
    margin-top: 20px;
}

.sidebar-account-label {
    color: #64748b;
    font-size: 10px;
    letter-spacing: 1px;
    margin-bottom: 7px;
}

.sidebar-email {
    color: #9ba9bb;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}


/* =====================================================
   LOGOUT
   ===================================================== */

.sidebar-logout {
    width: 100%;
    margin-top: 12px;
    background: transparent;
    color: #f5c84c;
    border: 1px solid #c9a227;
    padding: 9px;
    cursor: pointer;
    font-size: 11px;
    font-weight: bold;
}

.sidebar-logout:hover {
    background: #c9a227;
    color: #07111f;
}


/* =====================================================
   MAIN
   ===================================================== */

.main-content {
    flex: 1;
    min-width: 0;
}


/* =====================================================
   HEADER
   ===================================================== */

.header {
    background: #0b1728;
    border-bottom: 1px solid #27384e;
    padding: 18px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    letter-spacing: 2px;
}

.subtitle {
    color: #9ba9bb;
    font-size: 12px;
    margin-top: 5px;
    letter-spacing: 1px;
}

.user-area {
    display: flex;
    align-items: center;
    gap: 15px;
}

.online {
    color: #53d769;
    font-size: 12px;
    font-weight: bold;
}


/* =====================================================
   CONTAINER
   ===================================================== */

.container {
    padding: 25px;
}


/* =====================================================
   PAGE
   ===================================================== */

.page {
    display: none;
}

.page.active {
    display: block;
}


/* =====================================================
   WELCOME
   ===================================================== */

.welcome {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 25px;
    margin-bottom: 20px;
}

.welcome-title {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 8px;
}

.welcome-text {
    color: #9ba9bb;
    font-size: 13px;
}


/* =====================================================
   DASHBOARD CARDS
   ===================================================== */

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.card {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 22px;
    min-height: 140px;
}

.card-title {
    color: #9ba9bb;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

.card-value {
    color: #f5c84c;
    font-size: 22px;
    font-weight: bold;
}

.card-description {
    color: #64748b;
    font-size: 11px;
    margin-top: 10px;
}


/* =====================================================
   ACCOUNT
   ===================================================== */

.account-box {
    margin-top: 20px;
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 22px;
}

.account-title {
    color: #f5c84c;
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 15px;
}

.account-row {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #17283d;
    padding: 10px 0;
    font-size: 13px;
}

.account-label {
    color: #9ba9bb;
}

.account-value {
    color: white;
}


/* =====================================================
   PAGE TITLES
   ===================================================== */

.page-title {
    color: #f5c84c;
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 8px;
}

.page-description {
    color: #9ba9bb;
    font-size: 13px;
    margin-bottom: 20px;
}


/* =====================================================
   MARKETS
   ===================================================== */

.markets-box {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 22px;
}

.market-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.market-item {
    background: #07111f;
    border: 1px solid #27384e;
    padding: 16px;
    color: #f5c84c;
    font-weight: bold;
    font-size: 13px;
    cursor: pointer;
}

.market-item:hover {
    border-color: #c9a227;
}


/* =====================================================
   MEMBERSHIP
   ===================================================== */

.membership-page-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.membership-card {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 22px;
    text-align: center;
}

.membership-card:hover {
    border-color: #c9a227;
}

.membership-card-title {
    color: #9ba9bb;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 15px;
}

.membership-price {
    color: #f5c84c;
    font-size: 25px;
    font-weight: bold;
}

.membership-card-description {
    color: #64748b;
    font-size: 11px;
    margin-top: 10px;
}

.membership-button {
    margin-top: 18px;
    width: 100%;
    padding: 10px;
    background: transparent;
    color: #f5c84c;
    border: 1px solid #c9a227;
    cursor: pointer;
}

.membership-button:hover {
    background: #c9a227;
    color: #07111f;
}


/* =====================================================
   GENERIC
   ===================================================== */

.content-box {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 25px;
}

.content-title {
    color: #f5c84c;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 10px;
}

.content-text {
    color: #9ba9bb;
    font-size: 13px;
    line-height: 1.6;
}


/* =====================================================
   AGUILACORE ECONOMIC NEWS
   ===================================================== */

.economic-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.economic-status {
    color: #53d769;
    font-size: 11px;
    font-weight: bold;
}


/* =====================================================
   ECONOMIC TOP PANEL
   ===================================================== */

.economic-top-panel {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 15px;
    margin-bottom: 18px;
}

.economic-info-box {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 16px 18px;
}

.economic-info-title {
    color: #f5c84c;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}

.economic-info-text {
    color: #64748b;
    font-size: 11px;
    margin-top: 7px;
}

.live-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    background: #0b1728;
    border: 1px solid #27384e;

    padding: 0 20px;

    color: #53d769;
    font-size: 11px;
    font-weight: bold;
}

.live-dot {
    width: 7px;
    height: 7px;
    background: #53d769;
    border-radius: 50%;
}


/* =====================================================
   FILTERS
   ===================================================== */

.news-filter-box {
    background: #0b1728;
    border: 1px solid #27384e;

    padding: 18px;

    margin-bottom: 18px;

    display: flex;
    align-items: flex-end;
    gap: 15px;
    flex-wrap: wrap;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.filter-label {
    color: #9ba9bb;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}

.filter-control {
    background: #07111f;
    color: white;
    border: 1px solid #27384e;

    padding: 10px 12px;

    min-width: 170px;

    font-size: 12px;

    outline: none;
}

.filter-control:focus {
    border-color: #c9a227;
}

.filter-button {
    background: transparent;
    color: #f5c84c;

    border: 1px solid #c9a227;

    padding: 10px 18px;

    cursor: pointer;

    font-size: 11px;
    font-weight: bold;

    height: 36px;
}

.filter-button:hover {
    background: #c9a227;
    color: #07111f;
}

.filter-clear {
    color: #9ba9bb;
    border-color: #27384e;
}

.filter-clear:hover {
    background: #27384e;
    color: white;
}


/* =====================================================
   FILTER STATUS
   ===================================================== */

.filter-status {
    color: #64748b;
    font-size: 11px;
    margin-bottom: 12px;
}


/* =====================================================
   AGUILACORE CALENDAR
   ===================================================== */

.agc-calendar {
    background: #0b1728;
    border: 1px solid #27384e;

    overflow: hidden;
}


/* =====================================================
   CALENDAR HEADER
   ===================================================== */

.agc-calendar-header {
    display: grid;

    grid-template-columns:
        90px
        1fr
        90px
        105px
        85px
        100px
        100px
        100px;

    background: #101e31;

    border-bottom: 1px solid #c9a227;

    padding: 13px 14px;

    color: #9ba9bb;

    font-size: 9px;

    font-weight: bold;

    letter-spacing: 1px;
}


/* =====================================================
   CALENDAR ROW
   ===================================================== */

.agc-news-row {

    display: grid;

    grid-template-columns:
        90px
        1fr
        90px
        105px
        85px
        100px
        100px
        100px;

    padding: 15px 14px;

    border-bottom: 1px solid #17283d;

    align-items: center;

    min-height: 65px;

    transition: 0.15s;
}

.agc-news-row:hover {
    background: #0d1b2e;
}


/* =====================================================
   DATE
   ===================================================== */

.agc-date {
    color: #64748b;
    font-size: 11px;
    line-height: 1.4;
}

.agc-date-day {
    color: #9ba9bb;
    font-size: 12px;
    font-weight: bold;
}

.agc-date-number {
    color: #64748b;
    font-size: 10px;
    margin-top: 2px;
}


/* =====================================================
   EVENT
   ===================================================== */

.agc-event {
    color: white;
    font-size: 12px;
    font-weight: bold;

    padding-right: 15px;
}

.agc-event-sub {
    color: #64748b;
    font-size: 9px;
    margin-top: 5px;
}


/* =====================================================
   CURRENCY
   ===================================================== */

.agc-currency {
    color: #f5c84c;

    font-size: 12px;

    font-weight: bold;

    text-align: center;
}


/* =====================================================
   IMPACT
   ===================================================== */

.agc-impact {
    text-align: center;
}

.impact-badge {

    display: inline-block;

    padding: 5px 9px;

    border: 1px solid;

    font-size: 9px;

    font-weight: bold;

    letter-spacing: .5px;
}

.impact-high {
    color: #ff5555;
    border-color: #713333;
    background: rgba(255,85,85,.08);
}

.impact-medium {
    color: #f5c84c;
    border-color: #6b5a21;
    background: rgba(245,200,76,.08);
}

.impact-low {
    color: #53d769;
    border-color: #285b32;
    background: rgba(83,215,105,.08);
}


/* =====================================================
   TIME
   ===================================================== */

.agc-time {
    color: #9ba9bb;
    text-align: center;
    font-size: 11px;
    font-weight: bold;
}


/* =====================================================
   VALUES
   ===================================================== */

.agc-value {
    color: #e2e8f0;
    text-align: center;
    font-size: 11px;
}

.agc-value.actual {
    color: white;
    font-weight: bold;
}

.agc-value.forecast {
    color: #9ba9bb;
}

.agc-value.previous {
    color: #64748b;
}


/* =====================================================
   NEWS LOADING
   ===================================================== */

.news-loading {
    padding: 45px 20px;

    text-align: center;

    color: #9ba9bb;

    font-size: 12px;
}

.news-loading-title {
    color: #f5c84c;

    font-weight: bold;

    margin-bottom: 8px;
}


/* =====================================================
   NEWS ERROR
   ===================================================== */

.news-error {

    margin: 15px;

    padding: 16px;

    border: 1px solid #713333;

    background: rgba(255,85,85,.05);

    color: #ff7777;

    font-size: 12px;

    line-height: 1.5;

}


/* =====================================================
   NO NEWS
   ===================================================== */

.no-news {
    padding: 45px;

    text-align: center;

    color: #64748b;

    font-size: 13px;
}


/* =====================================================
   FOOTER
   ===================================================== */

.footer {
    text-align: center;
    color: #64748b;
    font-size: 11px;
    padding: 25px;
}


/* =====================================================
   RESPONSIVE
   ===================================================== */

@media (max-width: 1200px) {

    .agc-calendar {
        overflow-x: auto;
    }

    .agc-calendar-header,
    .agc-news-row {
        min-width: 850px;
    }

}

@media (max-width: 1100px) {

    .membership-page-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .market-list {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 800px) {

    .sidebar {
        width: 200px;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .container {
        padding: 15px;
    }

    .header {
        padding: 15px;
    }

    .online {
        display: none;
    }

    .economic-top-panel {
        grid-template-columns: 1fr;
    }

    .live-indicator {
        min-height: 45px;
    }

}

@media (max-width: 600px) {

    .app-layout {
        display: block;
    }

    .sidebar {
        width: 100%;
        min-height: auto;
        border-right: none;
        border-bottom: 1px solid #c9a227;
    }

    .sidebar-spacer {
        display: none;
    }

    .membership-page-grid {
        grid-template-columns: 1fr;
    }

    .market-list {
        grid-template-columns: 1fr;
    }

    .economic-header {
        display: block;
    }

    .economic-status {
        margin-top: 10px;
    }

}

</style>

</head>

