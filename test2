    /*
       Sort oldest/newest according
       to actual calendar date/time.
    */

    filtered.sort(
        function(a, b) {

            const dateA =
                new Date(
                    buildDateTime(
                        a.date,
                        a.time
                    )
                ).getTime();


            const dateB =
                new Date(
                    buildDateTime(
                        b.date,
                        b.time
                    )
                ).getTime();


            return (
                dateA - dateB
            );

        }
    );


    if (
        filtered.length === 0
