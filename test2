                {
                    method: "GET",
                    headers: {
                        "Accept":
                            "application/json"
                    },
                    cache: "no-store"
                }
            );


        if (!response.ok) {

            throw new Error(
                "Economic calendar server returned HTTP " +
                response.status
            );

        }


        const result =
            await response.json();


        /*
           Accept several common response formats:

           1. [ ... ]
           2. { data: [ ... ] }
           3. { events: [ ... ] }
           4. { calendar: [ ... ] }
        */

        let events = [];


        if (
            Array.isArray(result)
        ) {

            events =
                result;

        } else if (
            Array.isArray(result.data)
        ) {

            events =
                result.data;

        } else if (
            Array.isArray(result.events)
        ) {

            events =
                result.events;

        } else if (
            Array.isArray(result.calendar)
        ) {

            events =
                result.calendar;

        }


        economicNewsData =
            normalizeEconomicNews(
                events
