/* =====================================================
   DATE NORMALIZATION
   ===================================================== */

function normalizeDate(
    value
) {

    if (
        !value ||
        value === "—"
    ) {

        return "";

    }


    const stringValue =
        String(
            value
        ).trim();


    /*
       Already YYYY-MM-DD
    */

    if (
        /^\d{4}-\d{2}-\d{2}$/
            .test(
                stringValue
            )
    ) {

        return stringValue;

    }


    /*
       ISO datetime
    */

    if (
        /^\d{4}-\d{2}-\d{2}T/
            .test(
                stringValue
            )
    ) {

        return stringValue
            .substring(
                0,
                10
            );

    }


    const parsed =
        new Date(
            stringValue
        );


    if (
        !isNaN(
            parsed.getTime()
        )
    ) {

        const year =
            parsed.getFullYear();


        const month =
            String(
                parsed.getMonth() + 1
            )
            .padStart(
                2,
                "0"
            );


        const day =
            String(
                parsed.getDate()
            )
            .padStart(
                2,
                "0"
            );


        return (
            year +
            "-" +
            month +
            "-" +
            day
        );

    }


    return stringValue;

}


/* =====================================================
   BUILD DATE TIME
   ===================================================== */

function buildDateTime(
    date,
    time
) {

    const normalizedDate =
        normalizeDate(
            date
        );


    if (
        !normalizedDate
    ) {

        return "1970-01-01T00:00:00";

    }


    let cleanTime =
        String(
            time || "00:00"
        );


    /*
       Remove timezone text when
       necessary for sorting.
    */

    cleanTime =
        cleanTime
            .replace(
                /[A-Z]{2,5}/g,
                ""
            )
            .trim();


    if (
        !/^\d{1,2}:\d{2}/
            .test(
                cleanTime
            )
    ) {

        cleanTime =
            "00:00";

    }


    return (
        normalizedDate +
        "T" +
        cleanTime
    );

}


/* =====================================================
   FORMAT DATE
   ===================================================== */

function formatDate(
    date
) {

    const normalized =
        normalizeDate(
            date
        );


    if (
        !normalized
    ) {

        return {
            month: "—",
            day: "",
            year: ""
        };

    }


    const parts =
        normalized.split("-");


    const year =
        parts[0];


    const monthNumber =
        parseInt(
            parts[1],
            10
        );


    const day =
        parts[2];


    const months = [

        "JAN",
        "FEB",
        "MAR",
        "APR",
        "MAY",
        "JUN",
        "JUL",
        "AUG",
        "SEP",
        "OCT",
        "NOV",
        "DEC"

    ];


    return {

        month:
            months[
                monthNumber - 1
            ] || "—",

        day:
            day || "",

        year:
            year || ""

    };

}


/* =====================================================
   LONG DATE
   ===================================================== */

function formatLongDate(
    date
) {

    const normalized =
        normalizeDate(
            date
        );


    if (
        !normalized
    ) {

        return date;

    }


    const parsed =
        new Date(
            normalized +
            "T00:00:00"
        );


    if (
        isNaN(
            parsed.getTime()
        )
    ) {

        return date;

    }


    return parsed.toLocaleDateString(
        "en-US",
        {
            month: "short",
            day: "numeric",
            year: "numeric"
        }
    );

}


/* =====================================================
   ESCAPE HTML
   ===================================================== */

function escapeHTML(
    value
) {

    return String(
        value === undefined ||
        value === null
            ? ""
            : value
    )
    .replace(
        /&/g,
        "&amp;"
    )
    .replace(
        /</g,
        "&lt;"
    )
    .replace(
        />/g,
        "&gt;"
    )
    .replace(
        /"/g,
        "&quot;"
    )
    .replace(
        /'/g,
        "&#039;"
    );

}


