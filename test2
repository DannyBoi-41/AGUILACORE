/* =====================================================
   NORMALIZE NEWS
   ===================================================== */

function normalizeEconomicNews(
    events
) {

    if (
        !Array.isArray(events)
    ) {

        return [];

    }


    return events
        .map(function(item) {

            return {

                date:
                    getFirstValue(
                        item,
                        [
                            "date",
                            "event_date",
                            "day"
                        ]
                    ),

                time:
                    getFirstValue(
                        item,
                        [
                            "time",
                            "event_time"
                        ]
                    ),

                event:
                    getFirstValue(
                        item,
                        [
                            "event",
                            "title",
                            "name"
                        ]
                    ),

                currency:
                    getFirstValue(
                        item,
                        [
                            "currency",
                            "country_currency"
                        ]
                    ),

                impact:
                    normalizeImpact(
                        getFirstValue(
                            item,
                            [
                                "impact",
                                "importance",
                                "importance_label"
                            ]
                        )
                    ),

                actual:
                    getFirstValue(
                        item,
                        [
                            "actual"
                        ]
                    ),

                forecast:
                    getFirstValue(
                        item,
                        [
                            "forecast",
                            "consensus"
                        ]
                    ),

                previous:
                    getFirstValue(
                        item,
                        [
                            "previous",
                            "prev"
                        ]
                    )

            };

        })
        .filter(function(item) {

            return (
                item.event ||
                item.currency ||
                item.date
            );

        });

}


/* =====================================================
   GET FIRST VALUE
   ===================================================== */

function getFirstValue(
    object,
    keys
) {

    for (
        let i = 0;
        i < keys.length;
        i++
    ) {

        const value =
            object[
                keys[i]
            ];


        if (
            value !== undefined &&
            value !== null &&
            value !== ""
        ) {

            return String(
                value
            );

        }

    }


    return "—";

}


/* =====================================================
   NORMALIZE IMPACT
   ===================================================== */

function normalizeImpact(
    impact
) {

    if (!impact) {

        return "LOW";

    }


    const value =
        String(
            impact
        )
        .toUpperCase();


    if (
        value.includes("HIGH") ||
        value === "3" ||
        value === "3.0"
    ) {

        return "HIGH";

    }


    if (
        value.includes("MEDIUM") ||
        value.includes("MED") ||
        value === "2" ||
        value === "2.0"
    ) {

        return "MEDIUM";

    }


    return "LOW";

}


/* =====================================================
   RENDER ECONOMIC NEWS
