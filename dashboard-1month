const SUPABASE_URL =
    "https://xgthdbuybfynumprkqgm.supabase.co";

const SUPABASE_PUBLISHABLE_KEY =
    "sb_publishable_6ooR6Iv8NSAbEsgIFjruZg_RVIgvo9v";

const supabaseClient =
    supabase.createClient(
        SUPABASE_URL,
        SUPABASE_PUBLISHABLE_KEY
    );


/* =====================================================
   ECONOMIC CALENDAR
   ===================================================== */

const ECONOMIC_CALENDAR_API =
    SUPABASE_URL +
    "/functions/v1/economic-calendar";

let economicNewsData = [];


/* =====================================================
   MEMBERSHIP STATE
   ===================================================== */

let currentMembership = null;


/* =====================================================
   CHECK LOGIN
   ===================================================== */

async function checkUser() {

    try {

        const {
            data,
            error
        } =
            await supabaseClient.auth.getUser();

        if (
            error ||
            !data ||
            !data.user
        ) {

            window.location.href =
                "index.html";

            return;

        }

        const user =
            data.user;

        const email =
            user.email || "";

        document.getElementById(
            "userEmail"
        ).textContent =
            email;

        document.getElementById(
            "sidebarEmail"
        ).textContent =
            email;


        /*
         * Load membership from Supabase.
         */

        await loadMembership(
            user.id
        );

    } catch (error) {

        console.error(
            "Authentication error:",
            error
        );

        window.location.href =
            "index.html";

    }

}


/* =====================================================
   LOAD MEMBERSHIP
   ===================================================== */

async function loadMembership(
    userId
) {

    try {

        const {
            data,
            error
        } =
            await supabaseClient
                .from("memberships")
                .select("*")
                .eq(
                    "user_id",
                    userId
                )
                .maybeSingle();


        if (error) {

            console.error(
                "Membership error:",
                error
            );

            setDefaultMembership();

            return;

        }


        if (!data) {

            console.warn(
                "No membership record found."
            );

            setDefaultMembership();

            return;

        }


        currentMembership =
            data;


        processMembership(
            data
        );


    } catch (error) {

        console.error(
            "Membership loading error:",
            error
        );

        setDefaultMembership();

    }

}


/* =====================================================
   DEFAULT MEMBERSHIP
   ===================================================== */

function setDefaultMembership() {

    currentMembership = {

        plan:
            "FREE",

        status:
            "ACTIVE",

        trial_start:
            null,

        trial_expiry:
            null,

        membership_start:
            null,

        membership_expiry:
            null

    };


    updateMembershipDisplay(
        "FREE",
        "ACTIVE"
    );

}


/* =====================================================
   PROCESS MEMBERSHIP
   ===================================================== */

function processMembership(
    membership
) {

    const plan =
        String(
            membership.plan || "FREE"
        ).toUpperCase();

    const status =
        String(
            membership.status || "ACTIVE"
        ).toUpperCase();


    /*
     * PAID MEMBERSHIP
     */

    if (
        plan === "1_MONTH" ||
        plan === "6_MONTHS" ||
        plan === "1_YEAR" ||
        plan === "LIFETIME"
    ) {

        processPaidMembership(
            membership
        );

        return;

    }


    /*
     * FREE TRIAL
     */

    if (
        plan === "FREE_TRIAL"
    ) {

        processFreeTrial(
            membership
        );

        return;

    }


    updateMembershipDisplay(
        "FREE",
        status
    );

}


/* =====================================================
   FREE TRIAL
   ===================================================== */

function processFreeTrial(
    membership
) {

    const expiry =
        membership.trial_expiry
            ? new Date(
                membership.trial_expiry
            )
            : null;


    if (
        !expiry ||
        isNaN(
            expiry.getTime()
        )
    ) {

        updateMembershipDisplay(
            "FREE_TRIAL",
            "ACTIVE"
        );

        return;

    }


    const now =
        new Date();


    const difference =
        expiry.getTime() -
        now.getTime();


    /*
     * TRIAL EXPIRED
     */

    if (
        difference <= 0
    ) {

        updateTrialExpired(
            expiry
        );

        return;

    }


    /*
     * TRIAL ACTIVE
     */

    const totalTrial =
        7 * 24 * 60 * 60 * 1000;


    let progress =
        (
            difference /
            totalTrial
        ) * 100;


    progress =
        Math.max(
            0,
            Math.min(
                100,
                progress
            )
        );


    const totalDays =
        Math.ceil(
            difference /
            (
                24 *
                60 *
                60 *
                1000
            )
        );


    document.getElementById(
        "sidebarMembership"
    ).textContent =
        "FREE TRIAL";


    document.getElementById(
        "userStatus"
    ).textContent =
        "FREE TRIAL";


    document.getElementById(
        "accountMembership"
    ).textContent =
        "FREE TRIAL";


    document.getElementById(
        "accountStatus"
    ).textContent =
        "ACTIVE";


    document.getElementById(
        "premiumStatusBadge"
    ).textContent =
        "● FREE TRIAL ACTIVE";


    document.getElementById(
        "trialDays"
    ).textContent =
        totalDays +
        (
            totalDays === 1
                ? " DAY"
                : " DAYS"
        );


    document.getElementById(
        "trialProgressBar"
    ).style.width =
        progress +
        "%";


    const formattedExpiry =
        expiry.toLocaleString(
            "en-PH",
            {
                dateStyle: "medium",
                timeStyle: "short"
            }
        );


    document.getElementById(
        "trialExpiry"
    ).textContent =
        "Trial expiration: " +
        formattedExpiry;


    document.getElementById(
        "accountTrialExpiry"
    ).textContent =
        formattedExpiry;


    document.getElementById(
        "expiredBox"
    ).style.display =
        "none";


    document.getElementById(
        "premiumStatusBox"
    ).classList.remove(
        "expired-status"
    );


    document.getElementById(
        "signalStatus"
    ).textContent =
        "PREMIUM";

}


/* =====================================================
   TRIAL EXPIRED
   ===================================================== */

function updateTrialExpired(
    expiry
) {

    document.getElementById(
        "sidebarMembership"
    ).textContent =
        "EXPIRED";


    document.getElementById(
        "userStatus"
    ).textContent =
        "EXPIRED";


    document.getElementById(
        "accountMembership"
    ).textContent =
        "FREE TRIAL";


    document.getElementById(
        "accountStatus"
    ).textContent =
        "EXPIRED";


    document.getElementById(
        "premiumStatusBadge"
    ).textContent =
        "● TRIAL EXPIRED";


    document.getElementById(
        "trialDays"
    ).textContent =
        "0 DAYS";


    document.getElementById(
        "trialProgressBar"
    ).style.width =
        "0%";


    const formattedExpiry =
        expiry.toLocaleString(
            "en-PH",
            {
                dateStyle: "medium",
                timeStyle: "short"
            }
        );


    document.getElementById(
        "trialExpiry"
    ).textContent =
        "Trial expired: " +
        formattedExpiry;


    document.getElementById(
        "accountTrialExpiry"
    ).textContent =
        formattedExpiry;


    document.getElementById(
        "premiumStatusBox"
    ).classList.add(
        "expired-status"
    );


    document.getElementById(
        "expiredBox"
    ).style.display =
        "block";


    document.getElementById(
        "signalStatus"
    ).textContent =
        "LOCKED";

}


/* =====================================================
   PAID MEMBERSHIP
   ===================================================== */

function processPaidMembership(
    membership
) {

    const plan =
        String(
            membership.plan
        ).toUpperCase();


    const status =
        String(
            membership.status || "ACTIVE"
        ).toUpperCase();


    let expiry = null;


    if (
        membership.membership_expiry
    ) {

        expiry =
            new Date(
                membership.membership_expiry
            );

    }


    /*
     * LIFETIME
     */

    if (
        plan === "LIFETIME"
    ) {

        updatePaidMembershipDisplay(
            plan,
            "ACTIVE",
            null
        );

        return;

    }


    /*
     * EXPIRED PAID MEMBERSHIP
     */

    if (
        status !== "ACTIVE" ||
        (
            expiry &&
            expiry.getTime() <=
            Date.now()
        )
    ) {

        updatePaidMembershipDisplay(
            plan,
            "EXPIRED",
            expiry
        );

        return;

    }


    /*
     * ACTIVE PAID MEMBERSHIP
     */

    updatePaidMembershipDisplay(
        plan,
        "ACTIVE",
        expiry
    );

}


