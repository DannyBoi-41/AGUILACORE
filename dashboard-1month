            "premiumStatusBadge"
        ).textContent =
            "● MEMBERSHIP EXPIRED";


        document.getElementById(
            "trialDays"
        ).textContent =
            "0 DAYS";


        document.getElementById(
            "trialProgressBar"
        ).style.width =
            "0%";


        document.getElementById(
            "expiredBox"
        ).style.display =
            "block";


        document.getElementById(
            "premiumStatusBox"
        ).classList.add(
            "expired-status"
        );


        return;

    }


    document.getElementById(
        "sidebarMembership"
    ).textContent =
        plan;


    document.getElementById(
        "userStatus"
    ).textContent =
        plan;


    document.getElementById(
        "accountMembership"
    ).textContent =
        plan;


    document.getElementById(
        "accountStatus"
    ).textContent =
        "ACTIVE";


    document.getElementById(
        "premiumStatusBadge"
    ).textContent =
        "● PREMIUM ACTIVE";


    document.getElementById(
        "trialDays"
    ).textContent =
        "PREMIUM";


    document.getElementById(
        "trialProgressBar"
    ).style.width =
        "100%";


    document.getElementById(
        "premiumStatusBox"
    ).classList.remove(
        "expired-status"
    );


    document.getElementById(
        "expiredBox"
    ).style.display =
        "none";


    if (
