            "newsTableContainer"
        );


    const empty =
        document.getElementById(
            "newsEmpty"
        );


    const errorBox =
        document.getElementById(
            "newsError"
        );


    const updated =
        document.getElementById(
            "newsUpdated"
        );


    loading.style.display =
        "block";


    table.style.display =
        "none";


    empty.style.display =
        "none";


    errorBox.style.display =
        "none";


    updated.textContent =
        "Updating...";


    try {

        const session =
            await getAuthenticatedSession();


        const response =
            await fetch(
                ECONOMIC_CALENDAR_API,
                {
                    method: "GET",

                    headers: {

                        "Content-Type":
                            "application/json",

                        "Authorization":
                            "Bearer " +
                            session.access_token,

                        "apikey":
                            SUPABASE_PUBLISHABLE_KEY

                    }
                }
            );


        const responseText =
            await response.text();


        let result = null;


        try {

            result =
                responseText
                    ? JSON.parse(
                        responseText
                    )
                    : null;

        } catch (
            jsonError
        ) {

            result = null;

        }


        if (
            !response.ok
        ) {

            let serverMessage =
                "";


            if (
                result &&
                result.message
            ) {

                serverMessage =
                    result.message;

            } else if (
                result &&
                result.error
            ) {

                serverMessage =
                    result.error;

            } else if (
                responseText
            ) {

                serverMessage =
                    responseText;

            }


            throw new Error(
                "Economic calendar API returned HTTP " +
                response.status +
                (
                    serverMessage
                        ? " — " +
                          serverMessage
                        : ""
                )
            );

        }


        if (
            result === null
        ) {

            throw new Error(
                "Economic calendar returned an empty response."
            );

        }


        let events = [];


        if (
            Array.isArray(
                result
            )
        ) {

            events =
                result;

        } else if (
            Array.isArray(
                result.events
            )
        ) {

            events =
                result.events;

        } else if (
            Array.isArray(
                result.data
            )
        ) {

            events =
                result.data;

        } else if (
            result.data &&
            Array.isArray(
                result.data.events
            )
        ) {

            events =
                result.data.events;

        } else if (
            result.result &&
            Array.isArray(
                result.result.events
            )
        ) {

            events =
                result.result.events;

        }


        economicNewsData =
            events
                .map(
                    normalizeEconomicEvent
                )
                .filter(
                    function(event) {

                        return (
                            event.event ||
                            event.title
                        );

                    }
                );


        economicNewsData.sort(
            function(a, b) {

                return (
                    getEventTimestamp(a) -
                    getEventTimestamp(b)
                );

            }
        );


        loading.style.display =
            "none";


        updated.textContent =
            "Updated " +
            new Date().toLocaleTimeString(
                "en-PH",
                {
                    hour: "2-digit",
                    minute: "2-digit"
                }
            );


        renderEconomicNews();


    } catch (error) {

        console.error(
            "Economic Calendar Error:",
            error
        );


        loading.style.display =
            "none";


        table.style.display =
            "none";


        errorBox.textContent =
            "Unable to load economic calendar data. " +
            error.message;


        errorBox.style.display =
            "block";


        updated.textContent =
            "Data unavailable";

    }

}



/* =====================================================
   NORMALIZE EVENT
   ===================================================== */

function normalizeEconomicEvent(
    item
) {

    const event =
        item || {};


    return {

        date:
            event.date ||
            event.event_date ||
            event.datetime ||
            event.timestamp ||
            "",

        time:
            event.time ||
            event.event_time ||
            "",

        event:
            event.event ||
            event.title ||
            event.name ||
            event.event_name ||
            "",

        title:
            event.title ||
            event.event ||
            event.name ||
            "",

        currency:
            event.currency ||
            event.country ||
            event.currency_code ||
            "",

        impact:
            normalizeImpact(
                event.impact ||
                event.importance ||
                event.volatility ||
                ""
            ),

        actual:
            valueOrDash(
                event.actual
            ),

        forecast:
            valueOrDash(
                event.forecast
            ),

        previous:
            valueOrDash(
                event.previous
            )

    };

}



/* =====================================================
   NORMALIZE IMPACT
   ===================================================== */

function normalizeImpact(
    impact
) {

    const value =
        String(
            impact || ""
        ).toUpperCase();


    if (
        value.includes("HIGH") ||
        value === "3" ||
        value === "RED"
    ) {

        return "HIGH";

    }


    if (
        value.includes("MEDIUM") ||
        value.includes("MODERATE") ||
        value === "2" ||
        value === "ORANGE"
    ) {

        return "MEDIUM";

    }


    if (
        value.includes("LOW") ||
        value === "1" ||
        value === "YELLOW"
    ) {

        return "LOW";

    }


    return "LOW";

}



/* =====================================================
   VALUE
   ===================================================== */

function valueOrDash(
    value
) {

    if (
        value === null ||
        value === undefined ||
        value === ""
    ) {

        return "—";

    }


    return String(
        value
    );

}



/* =====================================================
   EVENT TIMESTAMP
   ===================================================== */

function getEventTimestamp(
    event
) {

    let value =
        event.date || "";


    if (
        event.time
    ) {

        value +=
            " " +
            event.time;

    }


    const timestamp =
        new Date(
            value
        ).getTime();


    if (
        isNaN(
            timestamp
        )
    ) {

        return 0;

    }


    return timestamp;

}



/* =====================================================
   DATE FORMAT
   ===================================================== */

function formatEventDate(
    dateValue
) {

    if (
        !dateValue
    ) {

        return "—";

    }


    const date =
        new Date(
            dateValue
        );


    if (
        isNaN(
            date.getTime()
        )
    ) {

        const match =
            String(
                dateValue
            ).match(
                /^(\d{4})-(\d{2})-(\d{2})/
            );


        if (
            match
        ) {

            return (
                match[2] +
                "/" +
                match[3]
            );

        }


        return String(
            dateValue
        );

    }


    return date.toLocaleDateString(
        "en-PH",
        {
            month: "short",
            day: "2-digit"
        }
    );

}



/* =====================================================
   DATE KEY
   ===================================================== */

function getDateKey(
    dateValue
) {

    if (
        !dateValue
    ) {

        return "";

    }


    const match =
        String(
            dateValue
        ).match(
            /^(\d{4})-(\d{2})-(\d{2})/
        );


    if (
        match
    ) {

        return (
            match[1] +
            "-" +
            match[2] +
            "-" +
            match[3]
        );

    }


    const date =
        new Date(
            dateValue
        );


    if (
        isNaN(
            date.getTime()
        )
    ) {

        return "";

    }


    const year =
        date.getFullYear();


    const month =
        String(
            date.getMonth() + 1
        ).padStart(
            2,
            "0"
        );


    const day =
        String(
            date.getDate()
        ).padStart(
            2,
            "0"
        );


    return (
        year +
        "-" +
        month +
        "-" +
        day
    );

}



/* =====================================================
   IMPACT HTML
   ===================================================== */

function impactHTML(
    impact
) {

    const safeImpact =
        impact || "LOW";


    const className =
        safeImpact.toLowerCase();


    return `
        <span class="impact-badge impact-${className}">
            <span class="impact-dot"></span>
            ${escapeHTML(safeImpact)}
        </span>
    `;

}



/* =====================================================
   ESCAPE HTML
   ===================================================== */

function escapeHTML(
    value
) {

    return String(
        value || ""
    )
    .replace(
        /&/g,
        "&amp;"
    )
    .replace(
        /</g,
        "&lt;"
    )
    .replace(
        />/g,
        "&gt;"
    )
    .replace(
        /"/g,
        "&quot;"
    )
    .replace(
        /'/g,
        "&#039;"
    );

}



/* =====================================================
   RENDER NEWS
   ===================================================== */

function renderEconomicNews() {

    const rows =
        document.getElementById(
            "economicNewsRows"
        );


    const table =
        document.getElementById(
            "newsTableContainer"
        );


    const empty =
        document.getElementById(
            "newsEmpty"
        );


    const selectedDate =
        document.getElementById(
            "newsDate"
        ).value;


    const selectedImpact =
        document.getElementById(
            "impactFilter"
        ).value;


    const filtered =
        economicNewsData.filter(
            function(event) {

                let dateMatch =
                    true;

                let impactMatch =
                    true;


                if (
                    selectedDate
                ) {

                    dateMatch =
                        getDateKey(
                            event.date
                        ) ===
                        selectedDate;

                }


                if (
                    selectedImpact !==
                    "ALL"
                ) {

                    impactMatch =
                        event.impact ===
                        selectedImpact;

                }


                return (
                    dateMatch &&
                    impactMatch
                );

            }
        );


    rows.innerHTML =
        "";


    document.getElementById(
        "newsCount"
    ).textContent =
        filtered.length;


    if (
        filtered.length === 0
    ) {

        table.style.display =
            "none";

        empty.style.display =
            "block";

        return;

    }


    empty.style.display =
        "none";


    table.style.display =
        "block";


    filtered.forEach(
        function(event) {

            const tr =
                document.createElement(
                    "tr"
                );


            const eventDate =
                getEventTimestamp(
                    event
                );


            const isPast =
                eventDate > 0 &&
                eventDate <
                Date.now();


            if (
                isPast
            ) {

                tr.classList.add(
                    "past-event"
                );

            }


            tr.innerHTML = `

                <td>
                    ${escapeHTML(
                        formatEventDate(
                            event.date
                        )
                    )}
                </td>

                <td>
                    ${escapeHTML(
                        event.time || "—"
                    )}
                </td>

                <td>
                    <div class="event-name">
                        ${escapeHTML(
                            event.event ||
                            event.title
                        )}
                    </div>
                </td>

                <td>
                    <span class="currency-badge">
                        ${escapeHTML(
                            event.currency || "—"
                        )}
                    </span>
                </td>

                <td>
                    ${impactHTML(
                        event.impact
                    )}
                </td>

                <td>
                    <span class="actual-value">
                        ${escapeHTML(
                            event.actual
                        )}
                    </span>
                </td>

                <td>
                    <span class="forecast-value">
                        ${escapeHTML(
                            event.forecast
                        )}
                    </span>
                </td>

                <td>
                    <span class="previous-value">
                        ${escapeHTML(
                            event.previous
                        )}
                    </span>
                </td>

            `;


            rows.appendChild(
                tr
            );

        }
    );

}



