<!DOCTYPE html>
<html lang="en">

<head>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ROLAND AGUILACORE Dashboard</title>

<style>

/* =====================================================
   GLOBAL
   ===================================================== */

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    background: #07111f;
    color: #f5c84c;
    font-family: Arial, Helvetica, sans-serif;
    min-height: 100vh;
}

body {
    overflow-x: hidden;
}

button,
input,
select {
    font-family: Arial, Helvetica, sans-serif;
}


/* =====================================================
   APP LAYOUT
   ===================================================== */

.app-layout {
    display: flex;
    min-height: 100vh;
}


/* =====================================================
   SIDEBAR
   ===================================================== */

.sidebar {
    width: 240px;
    min-height: 100vh;
    background: #0b1728;
    border-right: 1px solid #c9a227;
    padding: 22px 16px;
    display: flex;
    flex-direction: column;
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 100;
}

.sidebar-logo {
    color: #f5c84c;
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 2px;
}

.sidebar-subtitle {
    color: #64748b;
    font-size: 10px;
    margin-top: 5px;
    letter-spacing: 1px;
}


/* =====================================================
   MEMBERSHIP BOX
   ===================================================== */

.membership-box {
    margin-top: 25px;
    background: #07111f;
    border: 1px solid #27384e;
    padding: 15px;
    cursor: pointer;
    transition: 0.2s;
}

.membership-box:hover {
    border-color: #c9a227;
    background: #0d1b2e;
}

.membership-label {
    color: #64748b;
    font-size: 10px;
    letter-spacing: 1px;
}

.membership-value {
    color: #53d769;
    font-size: 18px;
    font-weight: bold;
    margin-top: 6px;
}

.membership-action {
    color: #64748b;
    font-size: 9px;
    margin-top: 8px;
}


/* =====================================================
   SIDEBAR MENU
   ===================================================== */

.sidebar-menu {
    margin-top: 25px;
}

.sidebar-item {
    color: #9ba9bb;
    padding: 12px 10px;
    margin-bottom: 4px;
    font-size: 13px;
    border-left: 2px solid transparent;
    cursor: pointer;
    transition: 0.2s;
}

.sidebar-item:hover {
    color: #f5c84c;
    background: #07111f;
    border-left: 2px solid #c9a227;
}

.sidebar-item.active {
    color: #f5c84c;
    background: #07111f;
    border-left: 2px solid #c9a227;
}


/* =====================================================
   ACCOUNT
   ===================================================== */

.sidebar-spacer {
    flex: 1;
}

.sidebar-account {
    border-top: 1px solid #27384e;
    padding-top: 15px;
    margin-top: 20px;
}

.sidebar-account-label {
    color: #64748b;
    font-size: 10px;
    letter-spacing: 1px;
    margin-bottom: 7px;
}

.sidebar-email {
    color: #9ba9bb;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}


/* =====================================================
   LOGOUT
   ===================================================== */

.sidebar-logout {
    width: 100%;
    margin-top: 12px;
    background: transparent;
    color: #f5c84c;
    border: 1px solid #c9a227;
    padding: 9px;
    cursor: pointer;
    font-size: 11px;
    font-weight: bold;
}

.sidebar-logout:hover {
    background: #c9a227;
    color: #07111f;
}


/* =====================================================
   MAIN
   ===================================================== */

.main-content {
    flex: 1;
    min-width: 0;
    margin-left: 240px;
}

.header {
    background: #0b1728;
    border-bottom: 1px solid #27384e;
    padding: 18px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    letter-spacing: 2px;
}

.subtitle {
    color: #9ba9bb;
    font-size: 12px;
    margin-top: 5px;
    letter-spacing: 1px;
}

.user-area {
    display: flex;
    align-items: center;
    gap: 15px;
}

.online {
    color: #53d769;
    font-size: 12px;
    font-weight: bold;
}

.container {
    padding: 25px;
}


/* =====================================================
   PAGE
   ===================================================== */

.page {
    display: none;
}

.page.active {
    display: block;
}


/* =====================================================
   WELCOME
   ===================================================== */

.welcome {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 25px;
    margin-bottom: 20px;
}

.welcome-title {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 8px;
}

.welcome-text {
    color: #9ba9bb;
    font-size: 13px;
}


/* =====================================================
   PREMIUM HEADER
   ===================================================== */

.premium-header {
    background:
        linear-gradient(
            135deg,
            #0d1b2e,
            #0b1728
        );

    border: 1px solid #c9a227;

    padding: 22px;

    margin-bottom: 18px;

    position: relative;

    overflow: hidden;
}

.premium-header::after {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    right: -70px;
    top: -90px;
    border: 1px solid rgba(245,200,76,0.25);
    border-radius: 50%;
}

.premium-label {
    color: #c9a227;
    font-size: 10px;
    letter-spacing: 2px;
    font-weight: bold;
}

.premium-title {
    color: #f5c84c;
    font-size: 26px;
    font-weight: bold;
    margin-top: 7px;
}

.premium-subtitle {
    color: #9ba9bb;
    font-size: 12px;
    margin-top: 7px;
}

.premium-status {
    display: inline-block;
    margin-top: 14px;
    padding: 6px 10px;
    border: 1px solid #276b3b;
    background: #0b2114;
    color: #53d769;
    font-size: 10px;
    font-weight: bold;
}


/* =====================================================
   PREMIUM GRID
   ===================================================== */

.premium-grid {
    display: grid;
    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 12px;

    margin-bottom: 18px;
}

.premium-card {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 18px;
    min-height: 120px;
}

.premium-card:hover {
    border-color: #8f7720;
}

.premium-card-label {
    color: #64748b;
    font-size: 9px;
    letter-spacing: 1px;
    font-weight: bold;
}

.premium-card-value {
    color: #f5c84c;
    font-size: 21px;
    font-weight: bold;
    margin-top: 12px;
}

.premium-card-small {
    color: #9ba9bb;
    font-size: 10px;
    margin-top: 7px;
}


/* =====================================================
   PREMIUM SIGNAL
   ===================================================== */

.signal-terminal {
    background: #0b1728;
    border: 1px solid #27384e;
    margin-bottom: 18px;
}

.signal-terminal-header {
    padding: 15px 18px;
    background: #0d1b2e;
    border-bottom: 1px solid #27384e;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.signal-terminal-title {
    color: #f5c84c;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 1px;
}

.signal-live {
    color: #53d769;
    font-size: 10px;
    font-weight: bold;
}

.signal-body {
    padding: 20px;
}

.signal-main {
    display: grid;
    grid-template-columns:
        1.3fr
        1fr
        1fr
        1fr
        1fr;

    gap: 10px;
}

.signal-direction {
    background: #07111f;
    border: 1px solid #27384e;
    padding: 18px;
}

.signal-direction-label {
    color: #64748b;
    font-size: 9px;
    letter-spacing: 1px;
}

.signal-direction-value {
    color: #53d769;
    font-size: 25px;
    font-weight: bold;
    margin-top: 10px;
}

.signal-box {
    background: #07111f;
    border: 1px solid #27384e;
    padding: 18px;
}

.signal-box-label {
    color: #64748b;
    font-size: 9px;
    letter-spacing: 1px;
}

.signal-box-value {
    color: white;
    font-size: 16px;
    font-weight: bold;
    margin-top: 10px;
}

.signal-box-value.gold {
    color: #f5c84c;
}

.signal-box-value.green {
    color: #53d769;
}

.signal-box-value.red {
    color: #ff6262;
}


/* =====================================================
   MARKET BIAS
   ===================================================== */

.bias-panel {
    background: #0b1728;
    border: 1px solid #27384e;
    margin-bottom: 18px;
}

.bias-header {
    padding: 15px 18px;
    background: #0d1b2e;
    border-bottom: 1px solid #27384e;
    color: #f5c84c;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 1px;
}

.bias-grid {
    display: grid;
    grid-template-columns:
        repeat(6, 1fr);
}

.bias-cell {
    padding: 15px;
    border-right: 1px solid #17283d;
    text-align: center;
}

.bias-cell:last-child {
    border-right: none;
}

.bias-tf {
    color: #64748b;
    font-size: 9px;
    letter-spacing: 1px;
}

.bias-value {
    margin-top: 8px;
    font-size: 12px;
    font-weight: bold;
}

.bias-buy {
    color: #53d769;
}

.bias-sell {
    color: #ff6262;
}

.bias-neutral {
    color: #9ba9bb;
}


/* =====================================================
   PREMIUM FEATURES
   ===================================================== */

.premium-features {
    display: grid;
    grid-template-columns:
        repeat(3, 1fr);

    gap: 15px;

    margin-bottom: 18px;
}

.feature-card {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 20px;
}

.feature-icon {
    color: #f5c84c;
    font-size: 20px;
}

.feature-title {
    color: white;
    font-size: 13px;
    font-weight: bold;
    margin-top: 12px;
}

.feature-text {
    color: #64748b;
    font-size: 11px;
    line-height: 1.6;
    margin-top: 8px;
}


/* =====================================================
   DASHBOARD
   ===================================================== */

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.card {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 22px;
    min-height: 140px;
}

.card-title {
    color: #9ba9bb;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

.card-value {
    color: #f5c84c;
    font-size: 22px;
    font-weight: bold;
}

.card-description {
    color: #64748b;
    font-size: 11px;
    margin-top: 10px;
}


/* =====================================================
   ACCOUNT
   ===================================================== */

.account-box {
    margin-top: 20px;
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 22px;
}

.account-title {
    color: #f5c84c;
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 15px;
}

.account-row {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #17283d;
    padding: 10px 0;
    font-size: 13px;
}

.account-label {
    color: #9ba9bb;
}

.account-value {
    color: white;
}


/* =====================================================
   TITLES
   ===================================================== */

.page-title {
    color: #f5c84c;
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 8px;
}

.page-description {
    color: #9ba9bb;
    font-size: 13px;
    margin-bottom: 20px;
}


/* =====================================================
   MARKETS
   ===================================================== */

.markets-box {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 22px;
}

.market-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.market-item {
    background: #07111f;
    border: 1px solid #27384e;
    padding: 16px;
    color: #f5c84c;
    font-weight: bold;
    font-size: 13px;
    cursor: pointer;
}

.market-item:hover {
    border-color: #c9a227;
}


/* =====================================================
   MEMBERSHIP
   ===================================================== */

.membership-page-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.membership-card {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 22px;
    text-align: center;
}

.membership-card:hover {
    border-color: #c9a227;
}

.membership-card-title {
    color: #9ba9bb;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 15px;
}

.membership-price {
    color: #f5c84c;
    font-size: 25px;
    font-weight: bold;
}

.membership-card-description {
    color: #64748b;
    font-size: 11px;
    margin-top: 10px;
}

.membership-button {
    margin-top: 18px;
    width: 100%;
    padding: 10px;
    background: transparent;
    color: #f5c84c;
    border: 1px solid #c9a227;
    cursor: pointer;
}

.membership-button:hover {
    background: #c9a227;
    color: #07111f;
}


/* =====================================================
   GENERIC
   ===================================================== */

.content-box {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 25px;
}

.content-title {
    color: #f5c84c;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 10px;
}

.content-text {
    color: #9ba9bb;
    font-size: 13px;
    line-height: 1.6;
}


/* =====================================================
   ECONOMIC NEWS
   ===================================================== */

.economic-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.economic-status {
    color: #53d769;
    font-size: 11px;
    font-weight: bold;
}


/* =====================================================
   NEWS CONTROL
   ===================================================== */

.news-control-panel {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 18px;
    margin-bottom: 18px;
}

.news-controls {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
}

.news-control {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.news-control label {
    color: #64748b;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 1px;
}

.news-control input,
.news-control select {
    background: #07111f;
    color: white;
    border: 1px solid #27384e;
    height: 38px;
    padding: 0 11px;
    min-width: 155px;
    outline: none;
}

.news-control input:focus,
.news-control select:focus {
    border-color: #c9a227;
}

.news-button {
    height: 38px;
    padding: 0 18px;
    border: 1px solid #c9a227;
    background: transparent;
    color: #f5c84c;
    cursor: pointer;
    font-size: 10px;
    font-weight: bold;
}

.news-button:hover {
    background: #c9a227;
    color: #07111f;
}

.news-button.secondary {
    border-color: #27384e;
    color: #9ba9bb;
}

.news-button.secondary:hover {
    background: #27384e;
    color: white;
}


/* =====================================================
   NEWS STATUS
   ===================================================== */

.news-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 12px;
    color: #64748b;
    font-size: 11px;
}

.news-count {
    color: #f5c84c;
    font-weight: bold;
}

.news-updated {
    color: #64748b;
}


/* =====================================================
   NEWS TABLE
   ===================================================== */

.aguilacore-calendar {
    background: #0b1728;
    border: 1px solid #27384e;
    overflow: hidden;
}

.calendar-titlebar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    background: #0d1b2e;
    border-bottom: 1px solid #27384e;
}

.calendar-title {
    color: #f5c84c;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 1px;
}

.calendar-timezone {
    color: #64748b;
    font-size: 10px;
}

.calendar-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
}

.calendar-table thead {
    background: #101e31;
}

.calendar-table th {
    text-align: left;
    color: #64748b;
    font-size: 9px;
    letter-spacing: 1px;
    padding: 13px 12px;
    border-bottom: 1px solid #27384e;
}

.calendar-table td {
    padding: 13px 12px;
    border-bottom: 1px solid #17283d;
    color: #d7dee8;
    font-size: 12px;
    vertical-align: middle;
}

.calendar-table tbody tr:hover {
    background: #0d1b2e;
}

.calendar-table th:nth-child(1),
.calendar-table td:nth-child(1) {
    width: 90px;
}

.calendar-table th:nth-child(2),
.calendar-table td:nth-child(2) {
    width: 85px;
}

.calendar-table th:nth-child(3),
.calendar-table td:nth-child(3) {
    width: auto;
}

.calendar-table th:nth-child(4),
.calendar-table td:nth-child(4) {
    width: 85px;
}

.calendar-table th:nth-child(5),
.calendar-table td:nth-child(5) {
    width: 100px;
}

.calendar-table th:nth-child(6),
.calendar-table td:nth-child(6) {
    width: 100px;
}

.calendar-table th:nth-child(7),
.calendar-table td:nth-child(7) {
    width: 100px;
}

.calendar-table th:nth-child(8),
.calendar-table td:nth-child(8) {
    width: 100px;
}


/* =====================================================
   EVENT
   ===================================================== */

.event-name {
    color: white;
    font-weight: bold;
}

.currency-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    padding: 5px 7px;
    background: #07111f;
    border: 1px solid #27384e;
    color: #f5c84c;
    font-size: 10px;
    font-weight: bold;
}


/* =====================================================
   IMPACT
   ===================================================== */

.impact-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: bold;
}

.impact-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
}

.impact-high {
    color: #ff6262;
}

.impact-high .impact-dot {
    background: #ff5555;
}

.impact-medium {
    color: #f5c84c;
}

.impact-medium .impact-dot {
    background: #f5c84c;
}

.impact-low {
    color: #53d769;
}

.impact-low .impact-dot {
    background: #53d769;
}


/* =====================================================
   VALUES
   ===================================================== */

.actual-value {
    color: #53d769;
    font-weight: bold;
}

.forecast-value {
    color: #9ba9bb;
}

.previous-value {
    color: #64748b;
}

.past-event {
    opacity: 0.72;
}


/* =====================================================
   LOADING
   ===================================================== */

.news-loading {
    padding: 45px 20px;
    text-align: center;
    color: #64748b;
    font-size: 12px;
}

.news-loading strong {
    display: block;
    color: #f5c84c;
    margin-bottom: 7px;
    font-size: 13px;
}


/* =====================================================
   EMPTY / ERROR
   ===================================================== */

.news-empty {
    display: none;
    padding: 45px 20px;
    text-align: center;
    color: #64748b;
    font-size: 12px;
}

.news-empty strong {
    display: block;
    color: #f5c84c;
    margin-bottom: 7px;
}

.news-error {
    display: none;
    padding: 18px;
    margin-bottom: 15px;
    background: #21131a;
    border: 1px solid #5c2733;
    color: #ff8b8b;
    font-size: 11px;
}


/* =====================================================
   FOOTER
   ===================================================== */

.footer {
    text-align: center;
    color: #64748b;
    font-size: 11px;
    padding: 25px;
}


/* =====================================================
   RESPONSIVE
   ===================================================== */

@media (max-width: 1200px) {

    .premium-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .signal-main {
        grid-template-columns: repeat(3, 1fr);
    }

    .bias-grid {
        grid-template-columns: repeat(3, 1fr);
    }

}

@media (max-width: 1100px) {

    .membership-page-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .market-list {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 900px) {

    .sidebar {
        width: 210px;
    }

    .main-content {
        margin-left: 210px;
    }

    .calendar-table {
        min-width: 800px;
    }

    .aguilacore-calendar {
        overflow-x: auto;
    }

    .premium-features {
        grid-template-columns: 1fr;
    }

}

@media (max-width: 800px) {

    .sidebar {
        width: 190px;
    }

    .main-content {
        margin-left: 190px;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .container {
        padding: 15px;
    }

    .header {
        padding: 15px;
    }

    .online {
        display: none;
    }

}

@media (max-width: 650px) {

    .app-layout {
        display: block;
    }

    .sidebar {
        position: relative;
        width: 100%;
