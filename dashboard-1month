   ===================================================== */

async function getAuthenticatedSession() {

    const {
        data,
        error
    } =
        await supabaseClient.auth.getSession();


    if (
        error
    ) {

        throw new Error(
            "Unable to read Supabase session."
        );

    }


    if (
        !data ||
        !data.session
    ) {

        throw new Error(
            "User session not found. Please login again."
        );

    }


    return data.session;

}



