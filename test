    document.getElementById(
        "lowEvents"
    ).textContent =
        low;

}


/* =====================================================
   FILTER ECONOMIC NEWS
   ===================================================== */

function filterEconomicNews() {

    const selectedDate =
        document.getElementById(
            "newsDate"
        ).value;


    const selectedImpact =
        document.getElementById(
            "impactFilter"
        ).value;


    const rows =
        document.querySelectorAll(
            ".news-row"
        );


    let visibleCount =
        0;


    rows.forEach(function(row) {

        const rowDate =
            row.dataset.date;


        const rowImpact =
            row.dataset.impact;


        let dateMatch =
            true;


        let impactMatch =
            true;


        if (
            selectedDate &&
            rowDate !== selectedDate
        ) {

            dateMatch =
                false;

        }


        if (
            selectedImpact !== "ALL" &&
            rowImpact !== selectedImpact
        ) {

            impactMatch =
                false;

        }


        if (
            dateMatch &&
            impactMatch
        ) {

            row.style.display =
                "grid";

            visibleCount++;

        }
        else {

            row.style.display =
                "none";

        }

    });


    const noNews =
        document.getElementById(
            "noNews"
        );


    if (
        visibleCount === 0
    ) {

        noNews.style.display =
            "block";

    }
    else {

        noNews.style.display =
            "none";

    }


    let statusText =
        "Showing " +
        visibleCount +
        " economic event";


    if (
        visibleCount !== 1
    ) {

        statusText +=
            "s";

    }


    if (selectedDate) {

        statusText +=
            " for " +
            formatDisplayDate(
                selectedDate
            );

    }


    if (
        selectedImpact !==
        "ALL"
    ) {

        statusText +=
            " • " +
            selectedImpact +
            " impact";

    }


    document.getElementById(
        "filterStatus"
    ).textContent =
        statusText;

}


/* =====================================================
