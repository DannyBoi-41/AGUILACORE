<!DOCTYPE html>
<html lang="en">

<head>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AGUILACORE Dashboard</title>

<style>

/* =====================================================
   GLOBAL
   ===================================================== */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #07111f;
    color: #f5c84c;
    font-family: Arial, Helvetica, sans-serif;
    min-height: 100vh;
}

button,
input,
select {
    font-family: Arial, Helvetica, sans-serif;
}

/* =====================================================
   APP LAYOUT
   ===================================================== */

.app-layout {
    display: flex;
    min-height: 100vh;
}

/* =====================================================
   LEFT SIDEBAR
   ===================================================== */

.sidebar {
    width: 240px;
    min-height: 100vh;
    background: #0b1728;
    border-right: 1px solid #c9a227;
    padding: 22px 16px;
    display: flex;
    flex-direction: column;
}

.sidebar-logo {
    color: #f5c84c;
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 2px;
}

.sidebar-subtitle {
    color: #64748b;
    font-size: 10px;
    margin-top: 5px;
    letter-spacing: 1px;
}

/* =====================================================
   MEMBERSHIP
   ===================================================== */

.membership-box {
    margin-top: 25px;
    background: #07111f;
    border: 1px solid #27384e;
    padding: 15px;
    cursor: pointer;
    transition: 0.2s;
}

.membership-box:hover {
    border-color: #c9a227;
    background: #0d1b2e;
}

.membership-label {
    color: #64748b;
    font-size: 10px;
    letter-spacing: 1px;
}

.membership-value {
    color: #53d769;
    font-size: 18px;
    font-weight: bold;
    margin-top: 6px;
}

.membership-action {
    color: #64748b;
    font-size: 9px;
    margin-top: 8px;
}

/* =====================================================
   SIDEBAR MENU
   ===================================================== */

.sidebar-menu {
    margin-top: 25px;
}

.sidebar-item {
    color: #9ba9bb;
    padding: 12px 10px;
    margin-bottom: 4px;
    font-size: 13px;
    border-left: 2px solid transparent;
    cursor: pointer;
    transition: 0.2s;
}

.sidebar-item:hover {
    color: #f5c84c;
    background: #07111f;
    border-left: 2px solid #c9a227;
}

.sidebar-item.active {
    color: #f5c84c;
    background: #07111f;
    border-left: 2px solid #c9a227;
}

/* =====================================================
   SIDEBAR ACCOUNT
   ===================================================== */

.sidebar-spacer {
    flex: 1;
}

.sidebar-account {
    border-top: 1px solid #27384e;
    padding-top: 15px;
    margin-top: 20px;
}

.sidebar-account-label {
    color: #64748b;
    font-size: 10px;
    letter-spacing: 1px;
    margin-bottom: 7px;
}

.sidebar-email {
    color: #9ba9bb;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* =====================================================
   LOGOUT
   ===================================================== */

.sidebar-logout {
    width: 100%;
    margin-top: 12px;
    background: transparent;
    color: #f5c84c;
    border: 1px solid #c9a227;
    padding: 9px;
    cursor: pointer;
    font-size: 11px;
    font-weight: bold;
}

.sidebar-logout:hover {
    background: #c9a227;
    color: #07111f;
}

/* =====================================================
   MAIN CONTENT
   ===================================================== */

.main-content {
    flex: 1;
    min-width: 0;
}

/* =====================================================
   HEADER
   ===================================================== */

.header {
    background: #0b1728;
    border-bottom: 1px solid #27384e;
    padding: 18px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    letter-spacing: 2px;
}

.subtitle {
    color: #9ba9bb;
    font-size: 12px;
    margin-top: 5px;
    letter-spacing: 1px;
}

.user-area {
    display: flex;
    align-items: center;
    gap: 15px;
}

.online {
    color: #53d769;
    font-size: 12px;
    font-weight: bold;
}

/* =====================================================
   CONTAINER
   ===================================================== */

.container {
    padding: 25px;
}

/* =====================================================
   PAGE SYSTEM
   ===================================================== */

.page {
    display: none;
}

.page.active {
    display: block;
}

/* =====================================================
   WELCOME
   ===================================================== */

.welcome {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 25px;
    margin-bottom: 20px;
}

.welcome-title {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 8px;
}

.welcome-text {
    color: #9ba9bb;
    font-size: 13px;
}

/* =====================================================
   DASHBOARD CARDS
   ===================================================== */

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.card {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 22px;
    min-height: 140px;
}

.card-title {
    color: #9ba9bb;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

.card-value {
    color: #f5c84c;
    font-size: 22px;
    font-weight: bold;
}

.card-description {
    color: #64748b;
    font-size: 11px;
    margin-top: 10px;
}

/* =====================================================
   ACCOUNT
   ===================================================== */

.account-box {
    margin-top: 20px;
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 22px;
}

.account-title {
    color: #f5c84c;
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 15px;
}

.account-row {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #17283d;
    padding: 10px 0;
    font-size: 13px;
}

.account-label {
    color: #9ba9bb;
}

.account-value {
    color: white;
}

/* =====================================================
   PAGE TITLES
   ===================================================== */

.page-title {
    color: #f5c84c;
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 8px;
}

.page-description {
    color: #9ba9bb;
    font-size: 13px;
    margin-bottom: 20px;
}

/* =====================================================
   MARKETS
   ===================================================== */

.markets-box {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 22px;
}

.market-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.market-item {
    background: #07111f;
    border: 1px solid #27384e;
    padding: 16px;
    color: #f5c84c;
    font-weight: bold;
    font-size: 13px;
    cursor: pointer;
}

.market-item:hover {
    border-color: #c9a227;
}

/* =====================================================
   MEMBERSHIP PAGE
   ===================================================== */

.membership-page-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.membership-card {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 22px;
    text-align: center;
}

.membership-card:hover {
    border-color: #c9a227;
}

.membership-card-title {
    color: #9ba9bb;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 15px;
}

.membership-price {
    color: #f5c84c;
    font-size: 25px;
    font-weight: bold;
}

.membership-card-description {
    color: #64748b;
    font-size: 11px;
    margin-top: 10px;
}

.membership-button {
    margin-top: 18px;
    width: 100%;
    padding: 10px;
    background: transparent;
    color: #f5c84c;
    border: 1px solid #c9a227;
    cursor: pointer;
}

.membership-button:hover {
    background: #c9a227;
    color: #07111f;
}

/* =====================================================
   GENERIC CONTENT
   ===================================================== */

.content-box {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 25px;
}

.content-title {
    color: #f5c84c;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 10px;
}

.content-text {
    color: #9ba9bb;
    font-size: 13px;
    line-height: 1.6;
}

/* =====================================================
   ECONOMIC NEWS
   ===================================================== */

.economic-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.economic-status {
    color: #53d769;
    font-size: 11px;
    font-weight: bold;
}

/* =====================================================
   ECONOMIC TOOLBAR
   ===================================================== */

.news-toolbar {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 18px;
    margin-bottom: 15px;
}

.news-toolbar-title {
    color: #f5c84c;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

.news-filter-box {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.filter-label {
    color: #9ba9bb;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}

.filter-control {
    background: #07111f;
    color: white;
    border: 1px solid #27384e;
    padding: 10px 12px;
    min-width: 170px;
    font-size: 12px;
    outline: none;
}

.filter-control:focus {
    border-color: #c9a227;
}

.filter-button {
    background: transparent;
    color: #f5c84c;
    border: 1px solid #c9a227;
    padding: 10px 18px;
    cursor: pointer;
    font-size: 11px;
    font-weight: bold;
    height: 36px;
}

.filter-button:hover {
    background: #c9a227;
    color: #07111f;
}

.filter-clear {
    color: #9ba9bb;
    border-color: #27384e;
}

.filter-clear:hover {
    background: #27384e;
    color: white;
}

/* =====================================================
   CALENDAR SUMMARY
   ===================================================== */

.news-summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 15px;
}

.news-summary-card {
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 13px 15px;
}

.news-summary-label {
    color: #64748b;
    font-size: 9px;
    letter-spacing: 1px;
    font-weight: bold;
}

.news-summary-value {
    color: #f5c84c;
    font-size: 18px;
    font-weight: bold;
    margin-top: 5px;
}

/* =====================================================
   FILTER STATUS
   ===================================================== */

.filter-status {
    color: #64748b;
    font-size: 11px;
    margin-bottom: 12px;
}

/* =====================================================
   AGUILACORE ECONOMIC CALENDAR
   ===================================================== */

.economic-calendar {
    background: #0b1728;
    border: 1px solid #27384e;
    overflow: hidden;
}

.calendar-head {
    display: grid;
    grid-template-columns:
        90px
        85px
        minmax(250px, 1fr)
        90px
        100px
        100px
        100px
        100px;

    background: #101e31;
    border-bottom: 1px solid #27384e;
    padding: 13px 15px;

    color: #64748b;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 1px;
}

.calendar-row {
    display: grid;

    grid-template-columns:
        90px
        85px
        minmax(250px, 1fr)
        90px
        100px
        100px
        100px
        100px;

    padding: 15px;
    border-bottom: 1px solid #17283d;
    align-items: center;

    font-size: 12px;
    transition: background 0.15s;
}

.calendar-row:last-child {
    border-bottom: none;
}

.calendar-row:hover {
    background: #0d1b2e;
}

.calendar-date {
    color: #9ba9bb;
    font-size: 11px;
}

.calendar-time {
    color: #f5c84c;
    font-weight: bold;
    font-size: 11px;
}

.calendar-event {
    color: white;
    font-weight: bold;
    padding-right: 15px;
}

.calendar-currency {
    color: #f5c84c;
    font-weight: bold;
}

.calendar-impact {
    font-weight: bold;
    font-size: 10px;
    letter-spacing: 0.5px;
}

.impact-high {
    color: #ff5555;
}

.impact-medium {
    color: #f5c84c;
}

.impact-low {
    color: #53d769;
}

.calendar-value {
    color: #d1d5db;
    font-size: 11px;
}

.actual-positive {
    color: #53d769;
}

.actual-negative {
    color: #ff5555;
}

.actual-neutral {
    color: #9ba9bb;
}

/* =====================================================
   EVENT IMPORTANCE DOT
   ===================================================== */

.impact-cell {
    display: flex;
    align-items: center;
    gap: 7px;
}

.impact-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
}

.dot-high {
    background: #ff5555;
}

.dot-medium {
    background: #f5c84c;
}

.dot-low {
    background: #53d769;
}

/* =====================================================
   EMPTY / LOADING
   ===================================================== */

.no-news {
    padding: 40px;
    text-align: center;
    color: #64748b;
    font-size: 13px;
}

.news-loading {
    padding: 40px;
    text-align: center;
    color: #f5c84c;
    font-size: 12px;
}

.news-error {
    margin: 15px;
    padding: 15px;
    border: 1px solid #5b2930;
    background: #21131a;
    color: #ff7777;
    font-size: 12px;
    display: none;
}

/* =====================================================
   SOURCE / DATA STATUS
   ===================================================== */

.news-source-box {
    margin-bottom: 15px;
    background: #0b1728;
    border: 1px solid #27384e;
    padding: 12px 15px;
    color: #64748b;
    font-size: 11px;
}

.news-source-status {
    color: #53d769;
    font-weight: bold;
}

.news-last-update {
    float: right;
    color: #64748b;
}

/* =====================================================
   FOOTER
   ===================================================== */

.footer {
    text-align: center;
    color: #64748b;
    font-size: 11px;
    padding: 25px;
}

/* =====================================================
   RESPONSIVE
   ===================================================== */

@media (max-width: 1200px) {

    .calendar-head,
    .calendar-row {
        grid-template-columns:
            80px
            75px
            minmax(220px, 1fr)
            80px
            90px
            90px
            90px
            90px;

        min-width: 900px;
    }

    .economic-calendar {
        overflow-x: auto;
    }

}

@media (max-width: 1100px) {

    .membership-page-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .market-list {
        grid-template-columns: repeat(2, 1fr);
    }

    .news-summary {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 800px) {

    .sidebar {
        width: 200px;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .container {
        padding: 15px;
    }

    .header {
        padding: 15px;
    }

    .online {
        display: none;
    }

}

@media (max-width: 600px) {

    .app-layout {
        display: block;
    }

    .sidebar {
        width: 100%;
        min-height: auto;
        border-right: none;
        border-bottom: 1px solid #c9a227;
    }

    .sidebar-spacer {
        display: none;
    }

    .membership-page-grid {
        grid-template-columns: 1fr;
    }

    .market-list {
        grid-template-columns: 1fr;
    }

    .economic-header {
        display: block;
    }

    .economic-status {
        margin-top: 10px;
    }

    .news-summary {
        grid-template-columns: 1fr 1fr;
    }

    .news-last-update {
        float: none;
        display: block;
        margin-top: 5px;
    }

}

</style>

</head>

