        ).value;


    let filteredEvents =
        economicNewsData.filter(
            function(event) {

                let dateMatch =
                    true;

                let impactMatch =
                    true;


                if (
                    selectedDate &&
                    event.date !== selectedDate
                ) {

                    dateMatch =
                        false;

                }


                if (
                    selectedImpact !==
                    "ALL" &&
                    event.impact !==
                    selectedImpact
                ) {

                    impactMatch =
                        false;

                }


                return (
                    dateMatch &&
                    impactMatch
                );

            }
        );


    /*
       Latest events first.
    */

    filteredEvents.sort(
        function(a, b) {

            const aKey =
                a.date +
                " " +
                a.time;

            const bKey =
                b.date +
                " " +
                b.time;


            return aKey.localeCompare(
                bKey
            );

        }
    );


    if (
        filteredEvents.length === 0
    ) {

        rowsContainer.innerHTML =
            '<div class="calendar-empty">No economic events match your filters.</div>';


        updateFilterStatus(
            0,
            selectedDate,
            selectedImpact
        );


        return;

    }


    let html = "";


    filteredEvents.forEach(
        function(event) {

            const impactClass =
                getImpactClass(
