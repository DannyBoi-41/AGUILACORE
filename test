/* =====================================================
   NORMALIZE ECONOMIC EVENTS
   ===================================================== */

function normalizeEconomicEvents(
    events
) {

    return events
        .map(function(event) {

            if (!event) {
                return null;
            }


            const date =
                cleanValue(
                    event.date ||
                    event.datetime ||
                    event.dateTime
                );


            const eventName =
                cleanValue(
                    event.event ||
                    event.title ||
                    event.name
                );


            const currency =
                cleanValue(
                    event.currency ||
                    event.country ||
                    event.currencyCode
                );


            const impact =
                normalizeImpact(
                    event.impact ||
                    event.importance
                );


            const time =
                cleanValue(
                    event.time ||
                    event.eventTime
                );


            const actual =
                cleanValue(
                    event.actual
                );


            const forecast =
                cleanValue(
                    event.forecast ||
                    event.expected
                );


            const previous =
                cleanValue(
                    event.previous
                );


            if (
                !date ||
                !eventName
            ) {

                return null;

            }


            return {

                date:
                    normalizeDate(
                        date
                    ),

                event:
                    eventName,

                currency:
                    currency || "—",

                impact:
                    impact,

                time:
                    time || "—",

                actual:
                    actual || "—",

                forecast:
                    forecast || "—",

                previous:
                    previous || "—"

            };

        })
        .filter(function(event) {

            return event !== null;

        });

}


/* =====================================================
   CLEAN VALUE
   ===================================================== */

function cleanValue(value) {

    if (
        value === undefined ||
        value === null
    ) {

        return "";

    }


    return String(value).trim();

}


/* =====================================================
   NORMALIZE DATE
   ===================================================== */

function normalizeDate(
    value
) {

    const text =
        cleanValue(value);


    /*
       Already YYYY-MM-DD
    */

    if (
        /^\d{4}-\d{2}-\d{2}$/.test(
            text
        )
    ) {

        return text;

    }


    /*
       ISO datetime
    */

    if (
        /^\d{4}-\d{2}-\d{2}T/.test(
            text
        )
    ) {

        return text.substring(
            0,
            10
        );

    }


    /*
       Try browser date parser.
    */

    const parsed =
        new Date(text);


    if (
        !isNaN(
            parsed.getTime()
        )
    ) {

        return parsed
            .toISOString()
            .substring(
                0,
                10
            );

    }


    return text;

}


/* =====================================================
   NORMALIZE IMPACT
   ===================================================== */

function normalizeImpact(
    value
) {

    const text =
        cleanValue(value)
            .toUpperCase();


    if (
        text.includes("HIGH") ||
        text === "3"
    ) {

        return "HIGH";

    }


    if (
        text.includes("MEDIUM") ||
        text.includes("MODERATE") ||
        text === "2"
    ) {

        return "MEDIUM";

    }


    if (
        text.includes("LOW") ||
        text === "1"
    ) {

        return "LOW";

    }


    /*
       If backend returns
       Investing-style importance
       values such as 3, 2, 1,
       they are normalized above.
    */

    return "LOW";

}


/* =====================================================
