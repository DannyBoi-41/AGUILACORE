    status.textContent =
        "● LOADING";


    status.style.color =
        "#f5c84c";


    sourceStatus.textContent =
        "CONNECTING TO AGUILACORE DATA";


    lastUpdated.textContent =
        "Fetching live economic events...";


    filterStatus.textContent =
        "Loading economic events...";


    rowsContainer.innerHTML =
        '<div class="calendar-loading">Loading live economic calendar...</div>';


    try {

        const response =
            await fetch(
                ECONOMIC_CALENDAR_ENDPOINT,
                {
                    method: "GET",
                    headers: {
                        "Accept":
                            "application/json"
                    },
                    cache: "no-store"
                }
            );


        if (!response.ok) {

            throw new Error(
                "Economic calendar server returned HTTP " +
                response.status
            );

        }


        const data =
            await response.json();


        /*
           Accept either:

           { events: [...] }

           or directly:

           [...]
        */

        let events = [];


        if (
            Array.isArray(data)
        ) {

            events =
                data;

        } else if (
            data &&
            Array.isArray(data.events)
        ) {

            events =
                data.events;

        }


        economicNewsData =
            normalizeEconomicEvents(
                events
            );


        if (
            economicNewsData.length === 0
