                        ${escapeHtml(
                            event.event
                        )}
                    </div>

                    <div class="calendar-currency">
                        ${escapeHtml(
                            event.currency
                        )}
                    </div>

                    <div class="calendar-impact ${impactClass}">
                        ${escapeHtml(
                            event.impact
                        )}
                    </div>

                    <div class="calendar-time">
                        ${escapeHtml(
                            event.time
                        )}
                    </div>

                    <div class="calendar-value">
                        ${escapeHtml(
                            event.actual
                        )}
                    </div>

                    <div class="calendar-value">
                        ${escapeHtml(
                            event.forecast
                        )}
                    </div>

                    <div class="calendar-value">
                        ${escapeHtml(
                            event.previous
                        )}
                    </div>

                </div>

            `;

        }
    );


    rowsContainer.innerHTML =
        html;


    updateFilterStatus(
        filteredEvents.length,
        selectedDate,
        selectedImpact
    );

}


/* =====================================================
   IMPACT CLASS
   ===================================================== */

function getImpactClass(
    impact
) {

    if (
        impact === "HIGH"
    ) {

        return "impact-high";

    }


    if (
        impact === "MEDIUM"
    ) {

        return "impact-medium";

    }


    return "impact-low";

}


/* =====================================================
   DATE DISPLAY
   ===================================================== */

function formatDate(
    dateString
) {

    if (
        !dateString
    ) {

        return "—";

    }


    const parts =
        dateString.split("-");


    if (
        parts.length !== 3
    ) {

        return dateString;

    }


    const year =
        Number(parts[0]);

    const month =
        Number(parts[1]) - 1;

    const day =
        Number(parts[2]);


    const date =
        new Date(
            year,
            month,
            day
        );


    if (
        isNaN(
            date.getTime()
        )
    ) {

        return dateString;

    }


    return date.toLocaleDateString(
        "en-US",
        {
            month: "short",
            day: "2-digit"
        }
    );

}


/* =====================================================
   UPDATED TIME
   ===================================================== */

function formatUpdatedTime(
    value
) {

    const date =
        new Date(value);


    if (
        isNaN(
            date.getTime()
        )
    ) {

        return value;

    }


    return date.toLocaleString(
        "en-US",
        {
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit"
        }
    );

}


