/* =====================================================
   ECONOMIC NEWS
   ===================================================== */

async function loadEconomicNews() {

    const rows =
        document.getElementById(
            "economicNewsRows"
        );

    const loading =
        document.getElementById(
            "newsLoading"
        );

    const empty =
        document.getElementById(
            "newsEmpty"
        );

    const errorBox =
        document.getElementById(
            "newsError"
        );

    rows.innerHTML = "";

    loading.style.display = "block";
    empty.style.display = "none";
    errorBox.style.display = "none";

    const selectedDate =
        document.getElementById(
            "newsDate"
        ).value;

    const selectedImpact =
        document.getElementById(
            "impactFilter"
        ).value;

    try {

        const params =
            new URLSearchParams();

        if (selectedDate) {

            params.set(
                "date",
                selectedDate
            );

        }

        if (
            selectedImpact &&
            selectedImpact !== "ALL"
        ) {

            params.set(
                "impact",
                selectedImpact
            );

        }

        const url =
            ECONOMIC_CALENDAR_ENDPOINT +
            "?" +
            params.toString();

        const response =
            await fetch(url, {

                method: "GET",

                headers: {

                    "Accept":
                        "application/json"

                }

            });

        if (!response.ok) {

            throw new Error(
                "Calendar API returned HTTP " +
                response.status
            );

        }

        const result =
            await response.json();

        const events =
            Array.isArray(result)
                ? result
                : result.events;

        if (
            !Array.isArray(events) ||
            events.length === 0
        ) {

            loading.style.display = "none";
            empty.style.display = "block";

            return;

        }

        events.forEach(function(event) {

            const tr =
                document.createElement("tr");

            const impact =
                String(
                    event.impact ||
                    event.importance ||
                    ""
                ).toUpperCase();

            let impactClass =
                "";

            if (impact === "HIGH") {

                impactClass =
                    "impact-high";

            } else if (
                impact === "MEDIUM"
            ) {

                impactClass =
                    "impact-medium";

            } else if (
                impact === "LOW"
            ) {

                impactClass =
                    "impact-low";

            }

            tr.innerHTML = `

                <td>
                    ${escapeHTML(
                        event.date || ""
                    )}
                </td>

                <td>
                    ${escapeHTML(
                        event.time || ""
                    )}
                </td>

                <td class="news-currency">
                    ${escapeHTML(
                        event.currency || ""
                    )}
                </td>

                <td class="news-event">
                    ${escapeHTML(
                        event.event || ""
                    )}
                </td>

                <td class="${impactClass}">
                    ${escapeHTML(
                        impact
                    )}
                </td>

                <td class="news-actual">
                    ${escapeHTML(
                        event.actual ?? "—"
                    )}
                </td>

                <td>
                    ${escapeHTML(
                        event.forecast ?? "—"
                    )}
                </td>

                <td>
                    ${escapeHTML(
                        event.previous ?? "—"
                    )}
                </td>

            `;

            rows.appendChild(tr);

        });

        loading.style.display = "none";

    } catch (err) {

        console.error(
            "Economic Calendar Error:",
            err
        );

        loading.style.display = "none";
        errorBox.style.display = "block";

    }

}


