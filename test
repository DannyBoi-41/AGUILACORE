async function loadEconomicNews() {

    const rowsContainer =
        document.getElementById(
            "economicNewsRows"
        );

    const sourceStatus =
        document.getElementById(
            "newsSourceStatus"
        );

    const lastUpdate =
        document.getElementById(
            "newsLastUpdate"
        );

    const errorBox =
        document.getElementById(
            "newsError"
        );


    rowsContainer.innerHTML =
        '<div class="news-loading">Loading live economic calendar...</div>';

    errorBox.style.display =
        "none";

    sourceStatus.textContent =
        "CONNECTING...";


    try {

        /*
         * IMPORTANT:
         *
         * The browser does NOT directly scrape
         * Investing.com.
         *
         * It requests our Supabase Edge Function.
         *
         * The Edge Function is responsible for
         * retrieving / processing the actual
         * economic-calendar data.
         */

        const functionUrl =
            SUPABASE_URL +
            "/functions/v1/economic-calendar";


        const response =
            await fetch(
                functionUrl,
                {
                    method: "GET",

                    headers: {
                        "Content-Type":
                            "application/json"
                    }
                }
            );


        if (!response.ok) {

            throw new Error(
                "Economic calendar server returned HTTP " +
                response.status
            );

        }


        const result =
            await response.json();


        /*
         * Accept common response structures.
         */

        let events = [];


        if (Array.isArray(result)) {

            events = result;

        }
        else if (
            Array.isArray(result.data)
        ) {

            events = result.data;

        }
        else if (
            Array.isArray(result.events)
        ) {

            events = result.events;

        }


        economicNewsData =
            normalizeEconomicNews(
                events
            );


        economicNewsLoaded =
            true;


        sourceStatus.textContent =
            "LIVE";


        sourceStatus.style.color =
            "#53d769";


        lastUpdate.textContent =
            "Updated " +
            new Date().toLocaleTimeString(
                [],
                {
                    hour: "2-digit",
                    minute: "2-digit"
                }
            );


        updateSummary();


        renderEconomicNews(
            economicNewsData
        );


    }
    catch (error) {

        console.error(
            "Economic Calendar Error:",
            error
        );


        sourceStatus.textContent =
            "CONNECTION ERROR";


        sourceStatus.style.color =
            "#ff5555";


        rowsContainer.innerHTML =
            "";


        errorBox.textContent =
            "Unable to load live economic calendar data. " +
            "Please check the AGUILACORE economic-calendar Edge Function.";

        errorBox.style.display =
            "block";


        document.getElementById(
            "filterStatus"
        ).textContent =
            "Economic calendar unavailable.";

    }

}


/* =====================================================
   NORMALIZE ECONOMIC NEWS
   ===================================================== */

function normalizeEconomicNews(events) {

    return events
        .map(function(event) {

            const rawDate =
                event.date ||
                event.datetime ||
                event.date_time ||
                event.timestamp ||
                "";


            let date =
                "";

            let time =
                "";


            if (rawDate) {

                const parsed =
                    new Date(rawDate);


                if (
                    !isNaN(
                        parsed.getTime()
                    )
                ) {

                    date =
                        formatDateISO(
                            parsed
                        );

                    time =
                        parsed.toLocaleTimeString(
                            [],
                            {
                                hour:
                                    "2-digit",
                                minute:
                                    "2-digit"
                            }
                        );

                }

            }


            if (
                !date &&
                event.event_date
            ) {

                date =
                    String(
                        event.event_date
                    );

            }


            if (
                !time &&
                event.time
            ) {

                time =
                    String(
                        event.time
                    );

            }


            let impact =
                String(
                    event.impact ||
                    event.importance ||
                    event.impact_level ||
                    "LOW"
                )
                .toUpperCase();


            if (
                impact.includes("HIGH") ||
                impact === "3"
            ) {

                impact =
                    "HIGH";

            }
            else if (
                impact.includes("MEDIUM") ||
                impact.includes("MODERATE") ||
                impact === "2"
            ) {

                impact =
                    "MEDIUM";

            }
            else {

                impact =
                    "LOW";

            }


            return {

                date:
                    date,

                time:
                    time || "—",

                event:
                    event.event ||
                    event.title ||
                    event.name ||
                    "Economic Event",

                currency:
                    event.currency ||
                    event.country ||
                    event.ccy ||
                    "—",

                impact:
                    impact,

                actual:
                    event.actual ??
                    event.actual_value ??
                    "—",

                forecast:
                    event.forecast ??
                    event.forecast_value ??
                    "—",

                previous:
                    event.previous ??
                    event.previous_value ??
                    "—"

            };

        })
        .filter(function(event) {

            return (
                event.event &&
                event.date
            );

        })
        .sort(function(a, b) {

            const first =
                new Date(
                    a.date +
                    "T" +
                    normalizeTime(
                        a.time
                    )
                );

            const second =
                new Date(
                    b.date +
                    "T" +
                    normalizeTime(
                        b.time
                    )
                );

            return (
                first - second
            );

        });

}


/* =====================================================
   DATE FORMAT
   ===================================================== */

function formatDateISO(date) {

    const year =
        date.getFullYear();

    const month =
        String(
            date.getMonth() + 1
        ).padStart(
            2,
            "0"
        );

    const day =
        String(
            date.getDate()
        ).padStart(
            2,
            "0"
        );


    return (
        year +
        "-" +
        month +
        "-" +
        day
    );

}


/* =====================================================
   TIME NORMALIZATION
   ===================================================== */

function normalizeTime(time) {

    if (!time) {

        return "00:00";

    }


    const value =
        String(time)
        .trim();


    if (
        /^\d{1,2}:\d{2}$/.test(
            value
        )
    ) {

        const parts =
            value.split(":");


        return (
            String(
                parts[0]
            ).padStart(
                2,
                "0"
            ) +
            ":" +
            parts[1]
        );

    }


    return "00:00";

}


/* =====================================================
   FORMAT DISPLAY DATE
   ===================================================== */

function formatDisplayDate(
    dateString
) {

    if (!dateString) {

        return "—";

    }


    const parts =
        dateString.split("-");


    if (
        parts.length !== 3
    ) {

        return dateString;

    }


    const date =
        new Date(
            Number(parts[0]),
            Number(parts[1]) - 1,
            Number(parts[2])
        );


    return date.toLocaleDateString(
        "en-US",
        {
            month: "short",
            day: "2-digit"
        }
    );

}


/* =====================================================
   ESCAPE HTML
   ===================================================== */

function escapeHTML(value) {

    if (
        value === null ||
        value === undefined
    ) {

        return "";

    }


    return String(value)
        .replace(
            /&/g,
            "&amp;"
        )
        .replace(
            /</g,
            "&lt;"
        )
        .replace(
            />/g,
            "&gt;"
        )
        .replace(
            /"/g,
            "&quot;"
        )
        .replace(
            /'/g,
            "&#039;"
        );

}


/* =====================================================
   IMPACT HTML
   ===================================================== */

function getImpactHTML(
    impact
) {

    const value =
        String(
            impact || "LOW"
        ).toUpperCase();


    let cssClass =
        "impact-low";


    let dotClass =
        "dot-low";


    if (
        value === "HIGH"
    ) {

        cssClass =
            "impact-high";

        dotClass =
            "dot-high";

    }
    else if (
        value === "MEDIUM"
    ) {

        cssClass =
            "impact-medium";

        dotClass =
            "dot-medium";

    }


    return `
        <div class="impact-cell">
            <span class="impact-dot ${dotClass}"></span>
            <span class="${cssClass}">
                ${escapeHTML(value)}
            </span>
        </div>
    `;

}


/* =====================================================
   ACTUAL VALUE CLASS
   ===================================================== */

function getActualClass(
    actual
) {

    if (
        actual === null ||
        actual === undefined ||
        actual === "" ||
        actual === "—"
    ) {

        return "actual-neutral";

    }


    return "actual-positive";

}


/* =====================================================
   RENDER CALENDAR
   ===================================================== */

function renderEconomicNews(
    events
) {

    const container =
        document.getElementById(
            "economicNewsRows"
        );

    const noNews =
        document.getElementById(
            "noNews"
        );


    container.innerHTML =
        "";


    if (
        !events ||
        events.length === 0
    ) {

        noNews.style.display =
            "block";

        document.getElementById(
            "filterStatus"
        ).textContent =
            "No economic events available.";

        return;

    }


    noNews.style.display =
        "none";


    events.forEach(function(event) {

        const row =
            document.createElement(
                "div"
            );


        row.className =
            "calendar-row news-row";


        row.dataset.date =
            event.date;


        row.dataset.impact =
            event.impact;


        row.innerHTML = `

            <div class="calendar-date">
                ${escapeHTML(
                    formatDisplayDate(
                        event.date
                    )
                )}
            </div>

            <div class="calendar-time">
                ${escapeHTML(
                    event.time
                )}
            </div>

            <div class="calendar-event">
                ${escapeHTML(
                    event.event
                )}
            </div>

            <div class="calendar-currency">
                ${escapeHTML(
                    event.currency
                )}
            </div>

            <div class="calendar-impact">
                ${getImpactHTML(
                    event.impact
                )}
            </div>

            <div class="calendar-value ${getActualClass(event.actual)}">
                ${escapeHTML(
                    event.actual
                )}
            </div>

            <div class="calendar-value">
                ${escapeHTML(
                    event.forecast
                )}
            </div>

            <div class="calendar-value">
                ${escapeHTML(
                    event.previous
                )}
            </div>

        `;


        container.appendChild(
            row
        );

    });


    filterEconomicNews();

}


/* =====================================================
