/* =====================================================
   FILTER STATUS
   ===================================================== */

function updateFilterStatus(
    count,
    selectedDate,
    selectedImpact
) {

    let statusText =
        "Showing " +
        count +
        " economic event";


    if (
        count !== 1
    ) {

        statusText +=
            "s";

    }


    if (
        selectedDate
    ) {

        statusText +=
            " for " +
            formatDate(
                selectedDate
            );

    }


    if (
        selectedImpact &&
        selectedImpact !==
        "ALL"
    ) {

        statusText +=
            " • " +
            selectedImpact +
            " impact";

    }


    document.getElementById(
        "filterStatus"
    ).textContent =
        statusText;

}


/* =====================================================
   ESCAPE HTML
   ===================================================== */

function escapeHtml(
    value
) {

    return String(
        value === undefined ||
        value === null
            ? ""
            : value
    )
    .replace(
        /&/g,
        "&amp;"
    )
    .replace(
        /</g,
        "&lt;"
    )
    .replace(
        />/g,
        "&gt;"
    )
    .replace(
        /"/g,
        "&quot;"
    )
    .replace(
        /'/g,
        "&#039;"
    );

}


